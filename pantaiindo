-- Membuat ScreenGui
local player = game:GetService("Players").LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "AutoMinigameGUI"
gui.Parent = player:WaitForChild("PlayerGui")

-- Membuat frame utama (lingkaran)
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 80, 0, 80)
frame.Position = UDim2.new(0, 20, 0.5, -40) -- Posisi kiri tengah
frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
frame.BackgroundTransparency = 0.3
frame.BorderSizePixel = 0
frame.Parent = gui

-- Membuat lingkaran (menggunakan UICorner)
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = frame

-- Membuat label ON/OFF
local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.Text = "OFF"
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.TextSize = 20
label.Font = Enum.Font.GothamBold
label.Parent = frame

-- Status toggle
local isActive = false
local running = false
local connection = nil

-- Fungsi untuk menunggu GUI MiniGameGUI
local function waitForMiniGameGUI()
    while running do
        local success, miniGameGUI = pcall(function()
            return player:WaitForChild("PlayerGui"):FindFirstChild("MiniGameGUI")
        end)
        
        if miniGameGUI then
            return true
        end
        task.wait(0.1)
    end
    return false
end

-- Fungsi untuk menjalankan proses
local function executeProcess()
    if not running then return end
    
    -- Step 1: Fire CastToPosition event
    local success, castEvent = pcall(function()
        return player.Character.LavaRod.CastToPosition
    end)
    
    if success and castEvent then
        castEvent:FireServer(nil)
    else
        task.wait(0.5)
        if running then executeProcess() end
        return
    end
    
    -- Tunggu 0.5 detik
    task.wait(0.5)
    
    if not running then return end
    
    -- Step 2: Tunggu MiniGameGUI muncul
    if waitForMiniGameGUI() then
        task.wait(0.2) -- Delay kecil untuk stabilisasi
        
        if not running then return end
        
        -- Step 3: Fire MiniGame Complete event
        local success2, miniGameEvent = pcall(function()
            return player.Character.LavaRod.MiniGame
        end)
        
        if success2 and miniGameEvent then
            miniGameEvent:FireServer("Complete")
        end
    end
    
    -- Loop lagi setelah selesai
    if running then
        task.wait(0.3)
        executeProcess()
    end
end

-- Fungsi toggle
local function toggle()
    isActive = not isActive
    
    if isActive then
        -- Turn ON
        frame.BackgroundColor3 = Color3.fromRGB(76, 175, 80) -- Hijau
        label.Text = "ON"
        running = true
        
        -- Mulai proses
        coroutine.wrap(function()
            executeProcess()
        end)()
    else
        -- Turn OFF
        frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50) -- Abu-abu
        label.Text = "OFF"
        running = false
    end
end

-- Menambahkan efek hover
local function onMouseEnter()
    if isActive then
        frame.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
    else
        frame.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    end
end

local function onMouseLeave()
    if isActive then
        frame.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
    else
        frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end

frame.MouseEnter:Connect(onMouseEnter)
frame.MouseLeave:Connect(onMouseLeave)
frame.MouseButton1Click:Connect(toggle)

-- Cleanup ketika karakter mati/respawn
local function onCharacterAdded()
    task.wait(1)
    if running then
        -- Restart process jika perlu
        running = false
        task.wait(0.5)
        running = true
        coroutine.wrap(function()
            executeProcess()
        end)()
    end
end

player.CharacterAdded:Connect(onCharacterAdded)

print("Auto Minigame Script Loaded - Click the circle to toggle ON/OFF")
