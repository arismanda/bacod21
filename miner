UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 and settingsFrame.Visible then
		local mousePos = UserInputService:GetMouseLocation()
		local framePos = settingsFrame.AbsolutePosition
		local frameSize = settingsFrame.AbsoluteSize

		if not (mousePos.X >= framePos.X and mousePos.X <= framePos.X + frameSize.X and
			mousePos.Y >= framePos.Y and mousePos.Y <= framePos.Y + frameSize.Y) then
			settingsFrame.Visible = false
		end
	end

	if input.KeyCode == Enum.KeyCode.X then
		walkEnabled = not walkEnabled
		updateUI()
		if walkEnabled then
			updateCharacter()
			resetTarget()
			findNewTarget()
			statusText.Text = "🟢 Auto Walk ON"
		else
			resetTarget()
			statusText.Text = "🔴 Auto Walk OFF"
			task.wait(1.5)
			statusText.Text = "⚙️ Klik tombol ⚙️ untuk pengaturan"
		end
	end
end)

player.CharacterAdded:Connect(function()
