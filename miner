-- ========== FUNGSI ==========

local function updateCharacter()
	currentCharacter = player.Character
	if currentCharacter and currentCharacter.Parent then
		currentHumanoid = currentCharacter:FindFirstChild("Humanoid")
		currentRootPart = currentCharacter:FindFirstChild("HumanoidRootPart")
		return currentHumanoid ~= nil and currentRootPart ~= nil
	end
	return false
end

-- FUNGSI SCAN PART (DIPANGGIL HANYA SAAT CARI TARGET BARU)
local function scanAllParts()
	local parts = {}
	local success, descendants = pcall(function() return workspace:GetDescendants() end)
	if not success or not descendants then return parts end

	for i = 1, #descendants do
		local obj = descendants[i]
		if obj and obj:IsA("BasePart") then
			-- Skip part milik player sendiri
			local isOwnPart = false
			if currentCharacter then
				if obj.Parent == currentCharacter or obj:IsDescendantOf(currentCharacter) then
					isOwnPart = true
				end
			end
			if not isOwnPart then
				-- Skip part tertentu
				local isExcluded = (obj.Name == "Baseplate" or obj.Name == "Terrain")
				if not isExcluded then
					local nameMatches = (targetPartName == "" or obj.Name == targetPartName)
					if nameMatches then
						table.insert(parts, obj)
					end
				end
			end
		end
	end
	
	print(string.format("📊 Scan completed: Found %d target parts", #parts))
	return parts
end

-- FUNGSI SCAN KARAKTER (DIPANGGIL HANYA SAAT CARI TARGET BARU)
local function scanAllCharacters()
	local characters = {}
	local success, descendants = pcall(function() return workspace:GetDescendants() end)
	if not success or not descendants then return characters end

	for i = 1, #descendants do
		local obj = descendants[i]
		if obj and obj:IsA("Humanoid") then
			local character = obj.Parent
			if character then
				local rootPart = character:FindFirstChild("HumanoidRootPart")
				if rootPart and rootPart:IsA("BasePart") then
					table.insert(characters, {
						humanoid = obj,
						character = character,
						rootPart = rootPart,
						name = character.Name or "Unknown"
					})
				end
			end
		end
	end
	
	return characters
end

-- CEK APAKAH PART AMAN (TIDAK ADA KARAKTER DI SEKITAR)
local function isPartSafe(part, allCharacters, checkRadius)
	if not part or not part.Position then return true end
	
	for i = 1, #allCharacters do
		local char = allCharacters[i]
		if char.character ~= currentCharacter then
			local success, distance = pcall(function()
				return (part.Position - char.rootPart.Position).Magnitude
			end)
			if success and distance and distance < checkRadius then
				return false, char.name
			end
		end
	end
	return true, nil
end

-- MENCARI TARGET TERDEKAT YANG AMAN (SCAN SEKALI SAAT DIPANGGIL)
local function findNearestSafePart()
	if not updateCharacter() then return nil end
	if not currentRootPart or not currentRootPart.Position then return nil end

	-- SCAN PART DAN KARAKTER SEKALI SAJA
	local allParts = scanAllParts()
	if not allParts or #allParts == 0 then
		return nil
	end
	
	local allCharacters = nil
	if avoidCharacters then
		allCharacters = scanAllCharacters()
	end

	local nearestPart = nil
	local shortestDistance = searchRadius

	for i = 1, #allParts do
		local part = allParts[i]
		if part and part.Parent then
			local success, distance = pcall(function()
				return (currentRootPart.Position - part.Position).Magnitude
			end)

			if success and distance then
				local isPartValid = true
				
				if avoidCharacters and allCharacters then
					local safe, _ = isPartSafe(part, allCharacters, avoidDistance)
					if not safe then
						isPartValid = false
					end
				end
				
				if isPartValid and distance < shortestDistance and distance > 2 then
					shortestDistance = distance
					nearestPart = part
				end
			end
		end
	end
	
	if nearestPart then
		print("🎯 Target found:", nearestPart.Name, "Distance:", shortestDistance)
	else
		print("🔍 No safe target found")
	end
	
	return nearestPart
end

local function leftClick()
	pcall(function()
		VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		task.wait(0.05)
		VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
	end)
end

local function startAutoClick()
	if clickTask then
		task.cancel(clickTask)
		clickTask = nil
	end

	clickTask = task.spawn(function()
		while isClicking and walkEnabled and currentTarget and currentTarget.Parent do
			leftClick()
			task.wait(clickDelay)
		end
	end)
end

local function stopAutoClick()
	if clickTask then
		task.cancel(clickTask)
		clickTask = nil
	end
end

local function findNewTarget()
	if not updateCharacter() then return false end

	local target = findNearestSafePart()

	if target then
		currentTarget = target
		autoWalkActive = true

		if targetPartName ~= "" then
			statusText.Text = "🎯 Target: " .. target.Name
		else
			statusText.Text = "🎯 Target: " .. target.Name
		end
		statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
		
		-- Update info karakter di UI (hanya sekali)
		if avoidCharacters then
			charNearText.Text = "✅ Target aman (tidak ada karakter dalam " .. avoidDistance .. " stud)"
			charNearText.TextColor3 = Color3.fromRGB(100, 255, 100)
		else
			charNearText.Text = "⏸️ Fitur hindari karakter NONAKTIF"
			charNearText.TextColor3 = Color3.fromRGB(150, 150, 150)
		end
		
		return true
	else
		if targetPartName ~= "" then
			statusText.Text = "⚠️ '" .. targetPartName .. "' tidak ditemukan"
		else
			if avoidCharacters then
				statusText.Text = "🔍 Tidak ada part aman (tanpa karakter) dalam radius " .. searchRadius
			else
				statusText.Text = "🔍 Tidak ada part dalam radius " .. searchRadius
			end
		end
		statusText.TextColor3 = Color3.fromRGB(255, 150, 0)
		autoWalkActive = false
		currentTarget = nil
		return false
	end
end

local function walkToTarget()
	if not currentTarget or not currentHumanoid or currentHumanoid.Health <= 0 then return end
	if not currentRootPart or not currentTarget.Position then return end

	local success, direction = pcall(function()
		return (currentTarget.Position - currentRootPart.Position).Unit
	end)

	if success and direction then
		local stopPosition = currentTarget.Position - (direction * stopDistance)
		currentHumanoid:MoveTo(stopPosition)
		currentHumanoid.AutoRotate = true
	end
end

local function stopWalking()
	if currentHumanoid and currentHumanoid.Health > 0 and currentRootPart then
		currentHumanoid:MoveTo(currentRootPart.Position)
	end
end

local function resetTarget()
	if isClicking then
		isClicking = false
		stopAutoClick()
	end
	autoWalkActive = false
	currentTarget = nil
	stopWalking()
end

local function updateUI()
	if walkEnabled then
		toggleButton.Text = "ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 120, 60)
	else
		toggleButton.Text = "OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	end

	if targetPartName ~= "" then
		targetText.Text = "Target: " .. targetPartName
	else
		targetText.Text = "Target: Semua part"
	end

	stopInfoText.Text = "Berhenti: " .. stopDistance .. " stud | Click mulai: " .. startClickDistance .. " stud"
	clickInfoText.Text = "Click delay: " .. clickDelay .. "s"

	if avoidCharacters then
		avoidCharToggle.Text = "ON"
		avoidCharToggle.BackgroundColor3 = Color3.fromRGB(0, 120, 60)
		avoidStatusText.Text = "Mode: Cari part tanpa karakter (saat target hilang)"
		avoidStatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
	else
		avoidCharToggle.Text = "OFF"
		avoidCharToggle.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		avoidStatusText.Text = "Mode: Cari semua part (saat target hilang)"
		avoidStatusText.TextColor3 = Color3.fromRGB(255, 150, 150)
	end
end

local function saveSettings()
	targetPartName = partNameInput.Text
	local newRadius = tonumber(radiusInput.Text)
	if newRadius and newRadius > 0 then searchRadius = math.min(newRadius, 200) end
	radiusInput.Text = tostring(searchRadius)

	local newStartClick = tonumber(startClickInput.Text)
	if newStartClick and newStartClick > 0 then startClickDistance = math.min(math.max(newStartClick, 2), 50) end
	startClickInput.Text = tostring(startClickDistance)

	local newStopDistance = tonumber(stopDistanceInput.Text)
	if newStopDistance and newStopDistance > 0 then stopDistance = math.min(math.max(newStopDistance, 2), 20) end
	stopDistanceInput.Text = tostring(stopDistance)

	if startClickDistance <= stopDistance then
		startClickDistance = stopDistance + 1
		startClickInput.Text = tostring(startClickDistance)
		statusText.Text = "⚠️ Mulai click harus > jarak berhenti!"
		task.wait(1.5)
	end

	local newClickDelay = tonumber(clickDelayInput.Text)
	if newClickDelay and newClickDelay > 0 then clickDelay = math.min(newClickDelay, 1) end
	clickDelayInput.Text = tostring(clickDelay)

	local newAvoidDistance = tonumber(avoidDistanceInput.Text)
	if newAvoidDistance and newAvoidDistance > 0 then avoidDistance = math.min(math.max(newAvoidDistance, 3), 30) end
	avoidDistanceInput.Text = tostring(avoidDistance)

	updateUI()
	settingsFrame.Visible = false

	statusText.Text = "✅ Setting tersimpan!"
	task.wait(1)
	if walkEnabled then
		statusText.Text = "🎯 Auto Walk & Click aktif"
	else
		statusText.Text = "⚙️ Klik tombol ⚙️ untuk pengaturan"
	end
end

avoidCharToggle.MouseButton1Click:Connect(function()
	avoidCharacters = not avoidCharacters
	updateUI()
	if avoidCharacters then
		statusText.Text = "✅ Mode: Cari part tanpa karakter (saat target hilang)"
	else
		statusText.Text = "⏸️ Mode: Cari semua part (saat target hilang)"
	end
	task.wait(1)
	if walkEnabled then
		resetTarget()
		findNewTarget()
	end
end)

-- ========== MAIN LOOP (TANPA SCAN, HANYA GERAK DAN CLICK) ==========
RunService.RenderStepped:Connect(function()
	if not walkEnabled then
		if autoWalkActive or isClicking then
			resetTarget()
		end
		return
	end

	if not updateCharacter() then
		return
	end

	if currentHumanoid.Health <= 0 then
		resetTarget()
		return
	end

	if not autoWalkActive then
		findNewTarget()
		return
	end

	-- CEK APAKAH TARGET MASIH ADA (TANPA SCAN)
	if not currentTarget or not currentTarget.Parent or not currentTarget:IsA("BasePart") then
		statusText.Text = "🔍 Target hilang, mencari target baru..."
		statusText.TextColor3 = Color3.fromRGB(255, 150, 0)
		resetTarget()
		findNewTarget()
		return
	end

	-- HANYA HITUNG JARAK (TIDAK ADA SCAN KARAKTER)
	local distanceToTarget = (currentRootPart.Position - currentTarget.Position).Magnitude
	distanceInfoText.Text = "Jarak: " .. string.format("%.1f", distanceToTarget) .. " stud"

	-- LOGIKA UTAMA
	if distanceToTarget <= stopDistance then
		if not isClicking then
			isClicking = true
			statusText.Text = "🔘 Auto click ON (sudah di target, jarak " .. string.format("%.1f", distanceToTarget) .. " stud)"
			statusText.TextColor3 = Color3.fromRGB(255, 100, 0)
			startAutoClick()
		end
		stopWalking()

	elseif distanceToTarget <= startClickDistance then
		if not isClicking then
			isClicking = true
			statusText.Text = "🔘 Auto click ON (dalam jangkauan, jarak " .. string.format("%.1f", distanceToTarget) .. " stud)"
			statusText.TextColor3 = Color3.fromRGB(255, 100, 0)
			startAutoClick()
		end
		walkToTarget()

	elseif distanceToTarget <= searchRadius then
		if isClicking then
			isClicking = false
			stopAutoClick()
			statusText.Text = "🚶 Menuju target (jarak " .. string.format("%.1f", distanceToTarget) .. " stud) - Click OFF"
			statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
		end
		walkToTarget()

	else
		statusText.Text = "📡 Target keluar radius, mencari target baru..."
		statusText.TextColor3 = Color3.fromRGB(255, 150, 0)
		resetTarget()
		findNewTarget()
	end
end)

