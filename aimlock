--------------------------------------------------
-- SCAN SEMUA HEAD DI MOBS (REALTIME)
--------------------------------------------------
local function scanAllHeads()
	local heads = {}
	local mobs = workspace:FindFirstChild("Mobs")
	
	if not mobs then
		return heads
	end
	
	-- Scan semua child di Mobs
	local function recursiveScan(parent)
		for _, child in ipairs(parent:GetChildren()) do
			-- Jika nemu part bernama Head
			if child:IsA("BasePart") and child.Name == "Head" then
				table.insert(heads, child)
			end
			-- Scan lebih dalam
			recursiveScan(child)
		end
	end
	
	recursiveScan(mobs)
	return heads
end


--------------------------------------------------
-- UPDATE DATABASE HEAD SETIAP DETIK
--------------------------------------------------
local function updateHeadDatabase()
	local newHeads = scanAllHeads()
	
	-- Cek apakah ada perubahan
	if #newHeads ~= #allHeads then
		allHeads = newHeads
		print("📊 Database updated! Total heads:", #allHeads)
		for i, head in ipairs(allHeads) do
			print("  " .. i .. ".", head:GetFullName())
		end
	else
		allHeads = newHeads
	end
end


--------------------------------------------------
-- DETEKSI HEAD BARU SECARA LANGSUNG
--------------------------------------------------
local function watchForNewHeads()
	local mobs = workspace:FindFirstChild("Mobs")
	if not mobs then return end
	
	-- Fungsi untuk monitor instance
	local function monitorInstance(instance)
		-- Jika instance adalah Head, update database
		if instance:IsA("BasePart") and instance.Name == "Head" then
			print("🆕 NEW HEAD DETECTED!", instance:GetFullName())
			updateHeadDatabase()
		end
		
		-- Monitor child baru dari instance ini
		instance.ChildAdded:Connect(function(child)
			if child:IsA("BasePart") and child.Name == "Head" then
				print("🆕 NEW HEAD ADDED!", child:GetFullName())
				updateHeadDatabase()
			end
			-- Monitor juga child dari child
			monitorInstance(child)
		end)
	end
	
	-- Monitor semua yang sudah ada di Mobs
	for _, child in ipairs(mobs:GetChildren()) do
		monitorInstance(child)
	end
	
	-- Monitor folder Mobs sendiri
	mobs.ChildAdded:Connect(function(newFolder)
		print("📁 New folder added to Mobs:", newFolder.Name)
		monitorInstance(newFolder)
		updateHeadDatabase()
	end)
end


--------------------------------------------------
-- CEK APAKAH HEAD DI LAYAR
--------------------------------------------------
local function isHeadOnScreen(head)
	local camera = workspace.CurrentCamera
	if not camera then return false end
	
	local screenPoint, onScreen = camera:WorldToScreenPoint(head.Position)
	return onScreen
end


--------------------------------------------------
-- CEK VISIBILITY (RAYCAST)
--------------------------------------------------
local function isHeadVisible(head)
	if not head or not head.Parent then
		return false
	end
	
	if not player.Character then
		return false
	end
	
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local direction = (head.Position - origin)
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	raycastParams.FilterDescendantsInstances = {player.Character}
	raycastParams.IgnoreWater = true
	
	local result = workspace:Raycast(origin, direction, raycastParams)
	
	if not result then
		return true
	end
	
	-- Cek apakah yang kena adalah head atau bagian dari mob yang sama
	local hit = result.Instance
	while hit do
		if hit == head or hit == head.Parent then
			return true
		end
		hit = hit.Parent
	end
	
	return false
end


--------------------------------------------------
-- CARI HEAD TERDEKAT DARI CROSSHAIR
--------------------------------------------------
local function findClosestHead()
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	
	local viewportCenter = camera.ViewportSize / 2
	local closestHead = nil
	local closestDistance = math.huge
	
	-- Update database dulu
	updateHeadDatabase()
	
	for _, head in ipairs(allHeads) do
		-- Cek apakah head masih ada
		if head and head.Parent then
			local screenPoint, onScreen = camera:WorldToScreenPoint(head.Position)
			
			-- Harus on screen
			if onScreen then
				-- Cek visibility (tidak terhalang)
				if isHeadVisible(head) then
					local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
					local distance = (screenPos - viewportCenter).Magnitude
					
					if distance < closestDistance then
						closestDistance = distance
						closestHead = head
					end
				end
			end
		end
	end
	
	return closestHead
end


--------------------------------------------------
-- LOCK CAMERA KE HEAD
--------------------------------------------------
local function lockToHead()
	if not lockedTarget or not lockedTarget.Parent then
		return false
	end
	
	local camera = workspace.CurrentCamera
	local currentPos = camera.CFrame.Position
	local targetPos = lockedTarget.Position
	
	-- Lock camera
	camera.CFrame = CFrame.new(currentPos, targetPos)
	return true
end


--------------------------------------------------
-- UPDATE AIMLOCK
--------------------------------------------------
local function updateAimlock()
	if not aiming then return end
	
	-- Update database setiap frame
	updateHeadDatabase()
	
	-- Cari target baru jika perlu
	if not lockedTarget or not lockedTarget.Parent or not isHeadVisible(lockedTarget) then
		local newTarget = findClosestHead()
		if newTarget then
			lockedTarget = newTarget
			print("🎯 Locked onto:", lockedTarget:GetFullName())
		else
			-- Tidak ada target
			return
		end
	end
	
	-- Lock camera
	if lockedTarget and lockedTarget.Parent then
		lockToHead()
	end
end


--------------------------------------------------
-- START AIMLOCK
--------------------------------------------------
local function startAimlock()
	if aiming then return end
	
	aiming = true
	
	if isMobile then
		animateProgress(true)
		updateButtonVisual(true)
	end
	
	-- Update database dan cari target
	updateHeadDatabase()
	lockedTarget = findClosestHead()
	
	if lockedTarget then
		print("🔒 AIMLOCK ACTIVE")
		print("🎯 Target:", lockedTarget:GetFullName())
		print("📍 Position:", lockedTarget.Position)
	else
		print("⚠️ NO HEAD FOUND ON SCREEN!")
		print("📊 Total heads in database:", #allHeads)
		print("💡 Tips:")
		print("   - Pastikan head ada di workspace.Mobs")
		print("   - Pastikan head visible di layar")
		print("   - Cek posisi kamera")
	end
end


--------------------------------------------------
-- STOP AIMLOCK
