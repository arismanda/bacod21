	mouse.Button2Down:Connect(startAimlock)
	mouse.Button2Up:Connect(stopAimlock)
end


--------------------------------------------------
-- INPUT: TOUCH BUTTON (MOBILE)
--------------------------------------------------
if isMobile then
	local holding = false
	local holdTimer = nil
	
	holdButton.MouseButton1Down:Connect(function()
		holding = true
		holdTimer = tick()
		startAimlock()
	end)
	
	holdButton.MouseButton1Up:Connect(function()
		holding = false
		stopAimlock()
	end)
	
	-- Untuk drag keluar dari button
	holdButton.MouseLeave:Connect(function()
		if holding then
			holding = false
			stopAimlock()
		end
	end)
end


