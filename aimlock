	if active then
		TweenService:Create(holdButton, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(0, 255, 0)}):Play()
		TweenService:Create(buttonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(0, 255, 0)}):Play()
		buttonText.Text = "LOCKED"
	else
		TweenService:Create(holdButton, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		TweenService:Create(buttonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		buttonText.Text = "AIM"
	end
end


