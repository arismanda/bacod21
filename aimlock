--------------------------------------------------
-- RECURSIVE: AMBIL SEMUA HEAD DARI SEMUA MOBS
--------------------------------------------------
local function getAllHeadsFromMobs()
	local heads = {}
	local mobs = workspace:FindFirstChild("Mobs")
	
	if not mobs then
		return heads
	end
	
	-- Fungsi rekursif untuk mencari semua part bernama "Head"
	local function searchForHeads(parent)
		for _, child in ipairs(parent:GetChildren()) do
			-- Jika child bernama "Head" dan merupakan BasePart
			if child.Name == "Head" and child:IsA("BasePart") then
				table.insert(heads, child)
			end
			-- Rekursif ke semua child
			searchForHeads(child)
		end
	end
	
	searchForHeads(mobs)
	return heads
end


--------------------------------------------------
-- CEK APAKAH HEAD TERLIHAT
--------------------------------------------------
local function isHeadVisible(targetHead)
	if not targetHead or not targetHead.Parent then
		return false
	end
	
	if not player.Character or not player.Character:FindFirstChild("Head") then
		return false
	end
	
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local targetPos = targetHead.Position
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	raycastParams.FilterDescendantsInstances = {player.Character}
	raycastParams.IgnoreWater = true
	
	local result = workspace:Raycast(origin, targetPos - origin, raycastParams)
	return result == nil
end


--------------------------------------------------
-- CARI HEAD TERDEKAT DI LAYAR
--------------------------------------------------
local function findClosestHeadOnScreen()
	local camera = workspace.CurrentCamera
	local viewportCenter = camera.ViewportSize / 2
	
	local allHeads = getAllHeadsFromMobs()
	local closestHead = nil
	local closestDistance = math.huge
	
	for _, head in ipairs(allHeads) do
		-- Cek apakah Head masih ada dan visible
		local screenPoint, onScreen = camera:WorldToScreenPoint(head.Position)
		
		if onScreen and isHeadVisible(head) then
			local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
			local distanceFromCenter = (screenPos - viewportCenter).Magnitude
			
			if distanceFromCenter < closestDistance then
				closestDistance = distanceFromCenter
				closestHead = head
			end
		end
	end
	
	return closestHead
end


--------------------------------------------------
-- UPDATE CAMERA UNTUK AIMLOCK
--------------------------------------------------
local function updateAimlock()
	if not aiming then return end
	
	-- Cari target jika belum ada atau target tidak valid
	if not lockedTarget or not isHeadVisible(lockedTarget) then
		lockedTarget = findClosestHeadOnScreen()
	end
	
	-- Jika ada target, lock camera ke head
	if lockedTarget and isHeadVisible(lockedTarget) then
		local camera = workspace.CurrentCamera
		local currentPos = camera.CFrame.Position
		local lookAtPos = lockedTarget.Position
		
		-- Buat CFrame baru yang melihat ke target head
		local newCFrame = CFrame.lookAt(currentPos, lookAtPos)
		camera.CFrame = newCFrame
	end
end


--------------------------------------------------
-- ANIMASI BUTTON
--------------------------------------------------
local function animateProgress(isHolding)
	if not isMobile then return end
	
	local goal = {}
	if isHolding then
		goal.ImageTransparency = 0.1
	else
		goal.ImageTransparency = 0.5
	end
	
	local tween = TweenService:Create(progressCircle, TweenInfo.new(0.2, Enum.EasingStyle.Quad), goal)
	tween:Play()
end

local function updateButtonVisual(active)
	if not isMobile then return end
	
	if active then
		local tween1 = TweenService:Create(holdButton, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(0, 255, 0)})
		local tween2 = TweenService:Create(buttonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(0, 255, 0)})
		tween1:Play()
		tween2:Play()
		buttonText.Text = "LOCKED"
	else
		local tween1 = TweenService:Create(holdButton, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(255, 255, 255)})
		local tween2 = TweenService:Create(buttonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
		tween1:Play()
		tween2:Play()
		buttonText.Text = "AIM"
	end
end


--------------------------------------------------
-- AIMLOCK START
--------------------------------------------------
local function startAimlock()
	if aiming then return end
	
	aiming = true
	
	if isMobile then
		animateProgress(true)
		updateButtonVisual(true)
	end
	
	-- Langsung cari target
	lockedTarget = findClosestHeadOnScreen()
	
	if lockedTarget then
		local headPath = lockedTarget:GetFullName()
		print("🔒 AIMLOCK ACTIVE - Locked onto:", headPath)
	else
		print("⚠️ No head found on screen")
	end
end


--------------------------------------------------
-- AIMLOCK STOP
--------------------------------------------------
local function stopAimlock()
	aiming = false
	lockedTarget = nil
	
	if isMobile then
		animateProgress(false)
		updateButtonVisual(false)
	end
	
	print("🔓 AIMLOCK DEACTIVATED")
end


--------------------------------------------------
-- RENDER STEP UNTUK AIMLOCK
--------------------------------------------------
RunService.RenderStepped:Connect(function()
	if aiming then
		updateAimlock()
	end
end)


--------------------------------------------------
-- INPUT: HOLD KLIK KANAN (PC)
--------------------------------------------------
if not isMobile then
	mouse.Button2Down:Connect(startAimlock)
	mouse.Button2Up:Connect(stopAimlock)
