--------------------------------------------------
-- RECURSIVE: AMBIL SEMUA HEAD DARI SEMUA MOBS (ANY DEPTH)
--------------------------------------------------
local function getAllHeadsFromMobs()
	local heads = {}
	local mobs = workspace:FindFirstChild("Mobs")
	
	if not mobs then
		warn("❌ 'Mobs' folder not found in workspace")
		return heads
	end
	
	-- Fungsi rekursif untuk mencari semua part bernama "Head"
	local function searchForHeads(parent)
		for _, child in ipairs(parent:GetChildren()) do
			-- Jika child bernama "Head" dan merupakan BasePart
			if child.Name == "Head" and child:IsA("BasePart") then
				table.insert(heads, child)
			end
			-- Rekursif ke child jika masih bisa di-crawl
			if child:IsA("Model") or child:IsA("Folder") or child:IsA("Part") or child:IsA("MeshPart") then
				searchForHeads(child)
			end
		end
	end
	
	searchForHeads(mobs)
	return heads
end


--------------------------------------------------
-- CEK APAKAH HEAD TERLIHAT (TIDAK TERHALANG)
--------------------------------------------------
local function isHeadVisible(targetHead)
	if not targetHead or not targetHead.Parent then
		return false
	end
	
	if not player.Character or not player.Character:FindFirstChild("Head") then
		return false
	end
	
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local targetPos = targetHead.Position
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	raycastParams.FilterDescendantsInstances = {
		player.Character
	}
	raycastParams.IgnoreWater = true
	
	local result = workspace:Raycast(origin, targetPos - origin, raycastParams)
	return result == nil
end


--------------------------------------------------
-- CARI HEAD MOB TERDEKAT DI LAYAR
--------------------------------------------------
local function findClosestMobHead()
	local camera = workspace.CurrentCamera
	local viewportCenter = camera.ViewportSize / 2
	
	local allHeads = getAllHeadsFromMobs()
	local closestHead = nil
	local closestDistance = math.huge
	
	for _, head in ipairs(allHeads) do
		local screenPoint, onScreen = camera:WorldToScreenPoint(head.Position)
		
		if onScreen and isHeadVisible(head) then
			local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
			local distanceFromCenter = (screenPos - viewportCenter).Magnitude
			
			if distanceFromCenter < closestDistance then
				closestDistance = distanceFromCenter
				closestHead = head
			end
		end
	end
	
	return closestHead
end


--------------------------------------------------
-- CEK APAKAH TARGET MASIH VALID
--------------------------------------------------
local function isTargetValid()
	if not lockedTarget then
		return false
	end
	
	if not lockedTarget.Parent or not lockedTarget.Parent:IsDescendantOf(workspace) then
		return false
	end
	
	if not isHeadVisible(lockedTarget) then
		return false
	end
	
	return true
end


--------------------------------------------------
-- ANIMASI PROGRESS CIRCLE
--------------------------------------------------
local function animateProgress(isHolding)
	if not isMobile then return end
	
	local goal = {}
	if isHolding then
		goal.ImageTransparency = 0.1
		goal.Rotation = 360
	else
		goal.ImageTransparency = 0.5
		goal.Rotation = 0
	end
	
	local tween = TweenService:Create(progressCircle, TweenInfo.new(0.3, Enum.EasingStyle.Quad), goal)
	tween:Play()
end


--------------------------------------------------
-- UPDATE BUTTON VISUAL
--------------------------------------------------
local function updateButtonVisual(active)
	if not isMobile then return end
	
	if active then
		local tween1 = TweenService:Create(holdButton, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(0, 255, 0)})
		local tween2 = TweenService:Create(buttonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(0, 255, 0)})
		tween1:Play()
		tween2:Play()
		buttonText.Text = "LOCKED"
	else
		local tween1 = TweenService:Create(holdButton, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(255, 255, 255)})
		local tween2 = TweenService:Create(buttonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
		tween1:Play()
		tween2:Play()
		buttonText.Text = "AIM"
	end
end


--------------------------------------------------
-- DRAG FUNCTIONALITY
--------------------------------------------------
local function startDrag(input)
	if not isMobile then return end
	dragging = true
	dragStart = input.Position
	buttonStartPos = holdButton.Position
end

local function onDrag(input)
	if not dragging or not isMobile then return end
	local delta = input.Position - dragStart
	local newX = buttonStartPos.X.Scale + delta.X / screenGui.AbsoluteSize.X
	local newY = buttonStartPos.Y.Scale + delta.Y / screenGui.AbsoluteSize.Y
	
	-- Clamp agar tidak keluar layar (batas margin 10px)
	newX = math.clamp(newX, 0.02, 0.98)
	newY = math.clamp(newY, 0.02, 0.98)
	
	holdButton.Position = UDim2.new(newX, 0, newY, 0)
end

local function stopDrag()
	dragging = false
end


--------------------------------------------------
-- AIMLOCK START
--------------------------------------------------
local function startAimlock()
	if aiming then return end
	
	aiming = true
	
	if isMobile then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		animateProgress(true)
		updateButtonVisual(true)
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end
	
	lockedTarget = findClosestMobHead()
	
	if lockedTarget then
		local path = lockedTarget.Parent and lockedTarget.Parent.Name or "Unknown"
		local parentPath = lockedTarget.Parent and lockedTarget.Parent.Parent and lockedTarget.Parent.Parent.Name or ""
		print("🔒 AIMLOCK ACTIVE - Locked onto:", parentPath .. "/" .. path, "HEAD")
	else
		print("❌ No mob heads found")
	end
	
	while aiming do
		RunService.RenderStepped:Wait()
		
		if lockedTarget and isTargetValid() then
			local camera = workspace.CurrentCamera
			local currentPos = camera.CFrame.Position
			camera.CFrame = CFrame.lookAt(currentPos, lockedTarget.Position)
		else
			lockedTarget = findClosestMobHead()
			if lockedTarget then
				local path = lockedTarget.Parent and lockedTarget.Parent.Name or "Unknown"
				print("🔄 Re-acquired:", path)
			end
		end
	end
end


--------------------------------------------------
-- AIMLOCK STOP
--------------------------------------------------
local function stopAimlock()
	aiming = false
	lockedTarget = nil
	
	if isMobile then
		animateProgress(false)
		updateButtonVisual(false)
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	
	print("🔓 AIMLOCK DEACTIVATED")
end


--------------------------------------------------
-- INPUT: HOLD KLIK KANAN (PC)
--------------------------------------------------
