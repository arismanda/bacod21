	mouse.Button2Down:Connect(startAimlock)
	mouse.Button2Up:Connect(stopAimlock)
end


--------------------------------------------------
-- INPUT: TOUCH BUTTON (MOBILE) + DRAG
--------------------------------------------------
if isMobile then
	local holding = false
	
	-- Touch untuk drag
	holdButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			-- Jika touch singkat dan tidak drag, trigger aimlock
			task.wait(0.1)
			if not dragging then
				holding = true
				startAimlock()
			end
			startDrag(input)
		end
	end)
	
	holdButton.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onDrag(input)
		end
	end)
	
	holdButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				stopDrag()
			end
			if holding then
				holding = false
				stopAimlock()
			end
		end
	end)
end


