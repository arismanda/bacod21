local function createPermanentSound()
	if warningSound then return end

	warningSound = Instance.new("Sound")
	warningSound.SoundId = "rbxassetid://129976960969174" -- Ganti dengan sound ID yang valid
	warningSound.Volume = settings.warningSoundVolume or 0.5
	warningSound.Parent = SoundService
end

local function playWarningSound()
	if not settings.enableWarningSound then return end

	-- Pastikan sound sudah dibuat
	if not warningSound then
		createPermanentSound()
	end

	-- Play sound (tanpa membuat baru)
	warningSound:Play()
end

