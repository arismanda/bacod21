function ESPManager:CreatePlayerItem(player)
	if not player or player == localPlayer then return end

	local itemName = "Player_" .. player.Name
	if self.playerContainer:FindFirstChild(itemName) or playerItems[player] then
		return
	end

	local itemFrame = Instance.new("Frame")
	itemFrame.Name = itemName
	itemFrame.Size = UDim2.new(1, 0, 0, 30)
	itemFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	itemFrame.BackgroundTransparency = 0.3
	itemFrame.BorderSizePixel = 0
	itemFrame.Parent = self.playerContainer

	local itemCorner = Instance.new("UICorner")
	itemCorner.CornerRadius = UDim.new(0, 4)
	itemCorner.Parent = itemFrame

	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.Size = UDim2.new(0, 25, 0, 25)
	avatar.Position = UDim2.new(0, 5, 0.5, -12)
	avatar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	avatar.BackgroundTransparency = 0.5
	avatar.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"

	local success, thumbnail = pcall(function()
		return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size48x48)
	end)
	if success and thumbnail then
		avatar.Image = thumbnail
	end

	avatar.Parent = itemFrame

	local avatarCorner = Instance.new("UICorner")
	avatarCorner.CornerRadius = UDim.new(1, 0)
	avatarCorner.Parent = avatar

	local displayName = getPlayerDisplayName(player)
	local nameText = if displayName ~= player.Name 
		then displayName .. " @" .. player.Name 
		else player.Name

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(0, 150, 1, 0)
	nameLabel.Position = UDim2.new(0, 35, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = nameText
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Font = Enum.Font.Gotham
	nameLabel.TextSize = 14
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Parent = itemFrame

	local distanceLabel = Instance.new("TextLabel")
	distanceLabel.Name = "DistanceLabel"
	distanceLabel.Size = UDim2.new(0, 50, 1, 0)
	distanceLabel.Position = UDim2.new(0, 190, 0, 0)
	distanceLabel.BackgroundTransparency = 1
	distanceLabel.Text = "?"
	distanceLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
	distanceLabel.Font = Enum.Font.Gotham
	distanceLabel.TextSize = 12
	distanceLabel.Parent = itemFrame

	local checkbox = Instance.new("ImageButton")
	checkbox.Name = "Checkbox"
	checkbox.Size = UDim2.new(0, 20, 0, 20)
	checkbox.Position = UDim2.new(1, -25, 0.5, -10)
	checkbox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	checkbox.BackgroundTransparency = 0.3
	checkbox.BorderSizePixel = 0
	checkbox.AutoButtonColor = false
	checkbox.Parent = itemFrame

	local checkboxCorner = Instance.new("UICorner")
	checkboxCorner.CornerRadius = UDim.new(0, 4)
	checkboxCorner.Parent = checkbox

	local checkmark = Instance.new("ImageLabel")
	checkmark.Name = "Checkmark"
	checkmark.Size = UDim2.new(0, 16, 0, 16)
	checkmark.Position = UDim2.new(0.5, -8, 0.5, -8)
	checkmark.BackgroundTransparency = 1
	checkmark.Image = "rbxasset://textures/ui/Windows/Icons/Checkmark.png"
	checkmark.ImageColor3 = Color3.fromRGB(0, 255, 0)
	checkmark.Visible = false
	checkmark.Parent = checkbox

	itemFrame:SetAttribute("PlayerName", player.Name)
	itemFrame:SetAttribute("PlayerDisplayName", displayName)
	itemFrame:SetAttribute("PlayerUserId", player.UserId)

	playerItems[player] = {
		frame = itemFrame,
		distanceLabel = distanceLabel,
		checkbox = checkbox,
		checkmark = checkmark,
		player = player
	}

	-- ============ LOGIKA OTOMATIS UNTUK PEMAIN BARU ============
	-- Jika mode Select All sedang aktif, centang pemain baru ini secara otomatis
	if isSelectAllActive then
		checkmark.Visible = true
		checkbox.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
		self:EnableESP(player)
	end
	-- =======================================================

	checkbox.MouseButton1Click:Connect(function()
		local newState = not checkmark.Visible
		checkmark.Visible = newState

		if newState then
			checkbox.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
			self:EnableESP(player)
		else
			checkbox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			self:DisableESP(player)
		end
	end)

	self:UpdatePlayerDistance(player, distanceLabel)

	if searchText ~= "" then
		local playerName = player.Name:lower()
		local playerDisplayName = displayName:lower()
		itemFrame.Visible = (string.find(playerName, searchText, 1, true) or 
			string.find(playerDisplayName, searchText, 1, true)) ~= nil
	end

	self:UpdatePlayerCount()

	return itemFrame
end
-- ================================================

function ESPManager:RemovePlayerItem(player)
	if playerItems[player] then
		local data = playerItems[player]
		if data.frame then
			data.frame:Destroy()
		end
		playerItems[player] = nil
	end

	self:RemoveESP(player)

	if distanceConnections[player] then
		distanceConnections[player]:Disconnect()
		distanceConnections[player] = nil
	end

	-- Clear notification status
	if notifiedPlayers[player] then
		notifiedPlayers[player] = nil
	end

	self:UpdatePlayerCount()
end

function ESPManager:UpdatePlayerDistance(player, distanceLabel)
	if not player or not distanceLabel then return end

	if distanceConnections[player] then
		distanceConnections[player]:Disconnect()
		distanceConnections[player] = nil
	end

	local function updateDistance()
		if not distanceLabel or not distanceLabel.Parent then
			if distanceConnections[player] then
				distanceConnections[player]:Disconnect()
				distanceConnections[player] = nil
			end
			return
		end

		local distance = self:GetPlayerDistance(player)
		if distance then
			distanceLabel.Text = formatDistance(distance)

			if distance < settings.warningDistance then
				distanceLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			elseif distance < 200 then
				distanceLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
			elseif distance < 500 then
				distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
			else
				distanceLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
			end
		else
			distanceLabel.Text = "?"
			distanceLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		end
	end

	updateDistance()

	local connection
	connection = RunService.Heartbeat:Connect(function()
		updateDistance()
	end)

	distanceConnections[player] = connection

	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		updateDistance()
	end)
end

function ESPManager:CreateESPForPlayer(player)
	if espObjects[player] then
		self:RemoveESP(player)
	end

	local esp = {}
	esp.Player = player
	local displayName = getPlayerDisplayName(player)

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_Highlight"
	highlight.FillColor = settings.farColor  -- <-- SEKARANG MENGIKUTI farColor
	highlight.FillTransparency = settings.highlightTransparency
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0.5

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.Size = UDim2.new(0, 180 * settings.billboardSize, 0, 50 * settings.billboardSize)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = settings.billboardEnabled
	billboard.ClipsDescendants = false

	local nameFrame = Instance.new("Frame")
	nameFrame.Size = UDim2.new(1, 0, 1, 0)
	nameFrame.BackgroundColor3 = settings.backgroundColor
	nameFrame.BackgroundTransparency = settings.billboardBgTransparency
	nameFrame.BorderSizePixel = 0
	nameFrame.Parent = billboard

	local nameCorner = Instance.new("UICorner")
	nameCorner.CornerRadius = UDim.new(0, 8)
	nameCorner.Parent = nameFrame

	local nameText = if displayName ~= player.Name 
		then displayName .. " [" .. player.Name .. "]" 
		else player.Name

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -10, 0.6, 0)
	nameLabel.Position = UDim2.new(0, 5, 0, 2)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = nameText
	nameLabel.TextColor3 = settings.textColor
	nameLabel.TextTransparency = settings.billboardTextTransparency
	nameLabel.TextScaled = true
	nameLabel.Font = settings.fontType
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.TextYAlignment = Enum.TextYAlignment.Center
	nameLabel.Parent = nameFrame

	local distanceLabel = Instance.new("TextLabel")
	distanceLabel.Name = "BillboardDistance"
	distanceLabel.Size = UDim2.new(1, -10, 0.3, 0)
	distanceLabel.Position = UDim2.new(0, 5, 0.65, 0)
	distanceLabel.BackgroundTransparency = 1
	distanceLabel.Text = "?"
	distanceLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
	distanceLabel.TextTransparency = settings.billboardTextTransparency
	distanceLabel.TextScaled = true
	distanceLabel.Font = settings.fontType
	distanceLabel.TextXAlignment = Enum.TextXAlignment.Center
	distanceLabel.TextYAlignment = Enum.TextYAlignment.Center
	distanceLabel.Parent = nameFrame

	local attachment1 = Instance.new("Attachment")
	attachment1.Name = "ESP_Attachment1"

	local attachment2 = Instance.new("Attachment")
	attachment2.Name = "ESP_Attachment2"

	local beam = Instance.new("Beam")
	beam.Name = "ESP_Beam"
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(settings.farColor)
	beam.Transparency = NumberSequence.new(settings.lineTransparency)  -- <-- TAMBAHKAN INI
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.TextureLength = 1
	beam.TextureSpeed = 0
	beam.Width0 = settings.lineThickness
	beam.Width1 = settings.lineThickness
	beam.Attachment0 = attachment1
	beam.Attachment1 = attachment2

	esp.Highlight = highlight
	esp.Billboard = billboard
	esp.Attachment1 = attachment1
	esp.Attachment2 = attachment2
	esp.Beam = beam
	esp.DistanceLabel = distanceLabel

	espObjects[player] = esp

	player.CharacterAdded:Connect(function(character)
		self:AttachESPToCharacter(player, character)
	end)

	if player.Character then
		self:AttachESPToCharacter(player, player.Character)
	end

	return esp
end

function ESPManager:AttachESPToCharacter(player, character)
	local esp = espObjects[player]
	if not esp then return end

	local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
	local head = character:WaitForChild("Head", 5)

	if not humanoidRootPart or not head then return end

	if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local localRoot = localPlayer.Character.HumanoidRootPart

		esp.Attachment1.Parent = localRoot
		esp.Attachment1.WorldCFrame = localRoot.CFrame

		esp.Attachment2.Parent = humanoidRootPart
		esp.Attachment2.WorldCFrame = humanoidRootPart.CFrame

		esp.Beam.Parent = workspace
	end

	esp.Highlight.Adornee = character
	esp.Highlight.Parent = character

	esp.Billboard.Adornee = head
	esp.Billboard.Parent = head

	local function updateBillboardDistance()
		if esp.DistanceLabel and esp.DistanceLabel.Parent then
			local distance = self:GetPlayerDistance(player)
			if distance then
				esp.DistanceLabel.Text = formatDistance(distance)
			else
				esp.DistanceLabel.Text = "?"
			end
		end
	end

	updateBillboardDistance()

	local connection = RunService.Heartbeat:Connect(updateBillboardDistance)

	if not esp.Connections then
		esp.Connections = {}
	end
	table.insert(esp.Connections, connection)
end

function ESPManager:EnableESP(player)
	if settings.enabled and not espObjects[player] then
		self:CreateESPForPlayer(player)
	end
end

function ESPManager:DisableESP(player)
	self:RemoveESP(player)
end

function ESPManager:RemoveESP(player)
	if espObjects[player] then
		local esp = espObjects[player]

		if esp.Connections then
			for _, conn in ipairs(esp.Connections) do
				conn:Disconnect()
			end
		end

		if esp.Highlight then esp.Highlight:Destroy() end
		if esp.Billboard then esp.Billboard:Destroy() end
		if esp.Attachment1 then esp.Attachment1:Destroy() end
		if esp.Attachment2 then esp.Attachment2:Destroy() end
		if esp.Beam then esp.Beam:Destroy() end

		espObjects[player] = nil
	end
end

function ESPManager:ClearAllESP()
	for player, _ in pairs(espObjects) do
		self:RemoveESP(player)
	end
end

function ESPManager:LoadInitialPlayers()
	for _, child in ipairs(self.playerContainer:GetChildren()) do
		if child.Name ~= "HeaderFrame" and child.Name ~= "Separator" and child.Name ~= "Layout" then
			if child:IsA("Frame") and child.Name:match("Player_") then
				child:Destroy()
			end
		end
	end

	playerItems = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			self:CreatePlayerItem(player)
		end
	end

	self:UpdatePlayerCount()
end

function ESPManager:Start()
	self:CreateMainGUI()
	self:LoadInitialPlayers()

	Players.PlayerAdded:Connect(function(player)
		if player ~= localPlayer then
			self:CreatePlayerItem(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		self:RemovePlayerItem(player)
	end)

	RunService.Heartbeat:Connect(function()
		if not settings.enabled then return end

		for player, esp in pairs(espObjects) do
			if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and 
				localPlayer and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then

				local targetRoot = player.Character.HumanoidRootPart
				local localRoot = localPlayer.Character.HumanoidRootPart

				if esp.Attachment1 and esp.Attachment1.Parent and esp.Attachment2 and esp.Attachment2.Parent then
					esp.Attachment1.WorldCFrame = localRoot.CFrame
					esp.Attachment2.WorldCFrame = targetRoot.CFrame

					if esp.Beam then esp.Beam.Enabled = true end
					if esp.Billboard then esp.Billboard.Enabled = settings.billboardEnabled end
				end
			else
				if esp.Beam then esp.Beam.Enabled = false end
				if esp.Billboard then esp.Billboard.Enabled = false end
			end
		end

		-- Check for nearby players and trigger notifications (ONLY ONCE)
		checkNearbyPlayers()
	end)
end

function ESPManager:Destroy()
	self:ClearAllESP()

	if settingsFrame then
		settingsFrame:Destroy()
		settingsFrame = nil
		isSettingsOpen = false
	end

	for player, connection in pairs(distanceConnections) do
		if connection then
			connection:Disconnect()
		end
	end
	distanceConnections = {}

	playerItems = {}
	playerQueue = {}

	if guiMain then
		guiMain:Destroy()
		guiMain = nil
	end
end

ESPManager:Start()
