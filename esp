-- Update line color based on distance
local function updateLineColorForPlayer(player, distance)
	local esp = espObjects[player]
	if not esp or not esp.Beam then return end

	local newColor
	local warningDist = settings.warningDistance

	if distance and distance <= warningDist then
		newColor = settings.closeColor
	else
		newColor = settings.farColor
	end

	if esp.Beam.Color ~= ColorSequence.new(newColor) then
		esp.Beam.Color = ColorSequence.new(newColor)
	end
end
-- Update highlight color based on distance
local function updateHighlightColorForPlayer(player, distance)
	local esp = espObjects[player]
	if not esp or not esp.Highlight then return end

	local newColor
	local warningDist = settings.warningDistance

	if distance and distance <= warningDist then
		newColor = settings.closeColor
	else
		newColor = settings.farColor
	end

	if esp.Highlight.FillColor ~= newColor then
		esp.Highlight.FillColor = newColor
	end
end
-- Reset notified status when player leaves warning distance
local function resetNotifiedStatus(player)
	if notifiedPlayers[player] then
		notifiedPlayers[player] = nil
	end
end

-- Check for nearby players and trigger notifications (ONLY ONCE per entry)
-- Check for nearby players and trigger notifications (ONLY ONCE per entry)
local function checkNearbyPlayers()
	if not settings.enabled or not settings.enableNotifications then return end

	local localChar = localPlayer.Character
	if not localChar then return end

	local localRoot = localChar:FindFirstChild("HumanoidRootPart")
	if not localRoot then return end

	for player, esp in pairs(espObjects) do
		if player and player ~= localPlayer then
			local distance = ESPManager:GetPlayerDistance(player)

			if distance and distance <= settings.warningDistance then
				-- Update line color
				updateLineColorForPlayer(player, distance)
				-- Update highlight color (NEW)
				updateHighlightColorForPlayer(player, distance)

				-- Check if we have NOT notified for this player yet
				local alreadyNotified = notifiedPlayers[player]

				if not alreadyNotified then
					-- Mark as notified FIRST to prevent multiple notifications
					notifiedPlayers[player] = true

					-- Play sound
					if settings.enableWarningSound then
						playWarningSound()
					end

					-- Show notification
					local playerName = getPlayerDisplayName(player)
					local distanceText = formatDistance(distance)
					showNotification("⚠️ WARNING!", 
						playerName .. " is within " .. distanceText, 3)

					-- Flash billboard frame for visual feedback
					if esp.Billboard then
						local frame = esp.Billboard:FindFirstChildWhichIsA("Frame")
						if frame then
							local originalColor = frame.BackgroundColor3
							frame.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
							task.wait(0.5)
							frame.BackgroundColor3 = originalColor
						end
					end
				end
			else
				-- Player is out of warning range, reset notification status
				if notifiedPlayers[player] then
					resetNotifiedStatus(player)
				end
				-- Reset to far color
				updateLineColorForPlayer(player, distance or math.huge)
				-- Reset highlight to far color (NEW)
				updateHighlightColorForPlayer(player, distance or math.huge)
			end
		end
	end
end

-- Reset all line colors
local function resetAllLineColors()
	for player, esp in pairs(espObjects) do
		if esp.Beam then
			esp.Beam.Color = ColorSequence.new(settings.farColor)
		end
	end
end

-- ============ PERBAIKAN UTAMA DI SINI ============
function ESPManager:SelectAllPlayers()
	-- Toggle status select all
	isSelectAllActive = not isSelectAllActive

	for player, data in pairs(playerItems) do
		-- Set status checkmark berdasarkan isSelectAllActive
		data.checkmark.Visible = isSelectAllActive

		if isSelectAllActive then
			data.checkbox.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
			self:EnableESP(player)
		else
			data.checkbox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			self:DisableESP(player)
		end
	end

	-- Update tampilan tombol Select All
	if selectAllButton then
		if isSelectAllActive then
			selectAllButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
			selectAllButton.ImageColor3 = Color3.fromRGB(0, 255, 0)
		else
			selectAllButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			selectAllButton.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end
end
