function ESPManager:ToggleContent()
	local contentFrame = self.contentFrame
	local searchFrame = self.searchFrame

	if isContentVisible then
		contentFrame.Visible = false
		searchFrame.Visible = false
		self.mainFrame.Size = UDim2.new(0, 300, 0, 45)
		isContentVisible = false
	else
		contentFrame.Visible = true
		searchFrame.Visible = true
		self.mainFrame.Size = UDim2.new(0, 300, 0, 450)
		isContentVisible = true
	end
end

function ESPManager:ToggleVisibility()
	isVisible = not isVisible
	if guiMain then
		guiMain.Enabled = isVisible
	end
end

function ESPManager:FilterPlayerList()
	for player, data in pairs(playerItems) do
		if data and data.frame then
			local playerName = player.Name:lower()
			local displayName = getPlayerDisplayName(player):lower()

			if searchText == "" or 
				string.find(playerName, searchText, 1, true) or 
				string.find(displayName, searchText, 1, true) then
				data.frame.Visible = true
			else
				data.frame.Visible = false
			end
		end
	end
end

function ESPManager:UpdatePlayerCount()
	local count = 0
	for player, data in pairs(playerItems) do
		if player and player ~= localPlayer and data and data.frame then
			count = count + 1
		end
	end

	if self.infoLabel then
		self.infoLabel.Text = "Total Players: " .. count
	end
end

function ESPManager:ProcessPlayerQueue()
	local processed = 0
	while #playerQueue > 0 and processed < 10 do
		local player = table.remove(playerQueue, 1)
		if player and player ~= localPlayer and not playerItems[player] then
			self:CreatePlayerItem(player)
			processed = processed + 1
		end
	end
	self:UpdatePlayerCount()
end

function ESPManager:GetPlayerDistance(player)
	if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or
		not localPlayer or not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	local targetRoot = player.Character.HumanoidRootPart
	local localRoot = localPlayer.Character.HumanoidRootPart

	return (localRoot.Position - targetRoot.Position).Magnitude
end

