local walkEnabled = false
local targetPartName = ""
local searchRadius = 50
local clickDelay = 0.05
local currentTarget = nil
local currentCharacter = nil
local currentHumanoid = nil
local currentRootPart = nil
local isNearTarget = false
local clickTask = nil
local scanDone = false

local function leftClick()
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function startAutoClick()
    if clickTask then
        task.cancel(clickTask)
        clickTask = nil
    end
    
    clickTask = task.spawn(function()
        while isNearTarget and walkEnabled do
            leftClick()
            task.wait(clickDelay)
        end
    end)
end

local function stopAutoClick()
    if clickTask then
        task.cancel(clickTask)
        clickTask = nil
    end
end

local function updateCharacter()
    currentCharacter = player.Character
    if currentCharacter then
        currentHumanoid = currentCharacter:FindFirstChild("Humanoid")
        currentRootPart = currentCharacter:FindFirstChild("HumanoidRootPart")
        return currentHumanoid ~= nil and currentRootPart ~= nil
    end
    return false
end

local function findNearestPart(radius)
    if not updateCharacter() then
        return nil
    end
    
    local nearestPart = nil
    local shortestDistance = radius
    
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part ~= currentRootPart then
            if part.Parent ~= currentCharacter and not part:IsDescendantOf(currentCharacter) then
                if targetPartName ~= "" and part.Name ~= targetPartName then
                    continue
                end
                
                if part.Name ~= "Baseplate" and part.Name ~= "Terrain" then
                    local distance = (currentRootPart.Position - part.Position).Magnitude
                    if distance < shortestDistance and distance > 2 then
                        shortestDistance = distance
                        nearestPart = part
                    end
                end
            end
        end
    end
    
    return nearestPart, shortestDistance
end

local function scanTarget()
    local nearestPart, distance = findNearestPart(searchRadius)
    
    if nearestPart then
        currentTarget = nearestPart
        scanDone = true
        
        if targetPartName ~= "" then
            statusText.Text = "🎯 Target ditemukan: " .. nearestPart.Name
        else
            statusText.Text = "🎯 Part terdekat: " .. nearestPart.Name
        end
        statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        return true
    else
        if targetPartName ~= "" then
            statusText.Text = "⚠️ '" .. targetPartName .. "' tidak ditemukan"
        else
            statusText.Text = "🔍 Tidak ada part dalam radius " .. searchRadius
        end
        statusText.TextColor3 = Color3.fromRGB(255, 150, 0)
        currentTarget = nil
        scanDone = false
        return false
    end
end

local function walkToPart(part)
    if not part or not currentHumanoid or currentHumanoid.Health <= 0 then
        return
    end
    
    currentHumanoid:MoveTo(part.Position)
    currentHumanoid.AutoRotate = true
end

local function stopWalking()
    if currentHumanoid and currentHumanoid.Health > 0 and currentRootPart then
        currentHumanoid:MoveTo(currentRootPart.Position)
    end
end

local function resetTarget()
    currentTarget = nil
    scanDone = false
    if isNearTarget then
        isNearTarget = false
        stopAutoClick()
    end
    stopWalking()
end

local function updateUI()
    if walkEnabled then
        toggleButton.Text = "ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
    else
        toggleButton.Text = "OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
    end
    
    if targetPartName ~= "" then
        targetText.Text = "📍 Target: " .. targetPartName .. " (radius " .. searchRadius .. ")"
    else
        targetText.Text = "📍 Target: Semua part (radius " .. searchRadius .. ")"
    end
    
    clickInfoText.Text = "🖱️ Click delay: " .. clickDelay .. "s"
end

local function saveSettings()
    targetPartName = partNameInput.Text
    local newRadius = tonumber(radiusInput.Text)
    if newRadius and newRadius > 0 then
        searchRadius = math.min(newRadius, 200)
    end
    radiusInput.Text = tostring(searchRadius)
    
    local newClickDelay = tonumber(clickDelayInput.Text)
    if newClickDelay and newClickDelay > 0 then
        clickDelay = math.min(newClickDelay, 1)
    end
    clickDelayInput.Text = tostring(clickDelay)
    
    updateUI()
    settingsFrame.Visible = false
    
    if walkEnabled then
        resetTarget()
        scanTarget()
    end
    
    statusText.Text = "✅ Setting tersimpan!"
    task.wait(1)
    if walkEnabled and currentTarget then
        statusText.Text = "🎯 Menuju target"
    elseif walkEnabled and not currentTarget then
        statusText.Text = "🔍 Target tidak ditemukan"
    else
        statusText.Text = "⚙️ Klik ⚙️ untuk setting"
    end
end

RunService.RenderStepped:Connect(function()
    if not walkEnabled then
        if currentTarget or isNearTarget then
            resetTarget()
        end
        return
    end
    
    if not updateCharacter() then
        return
    end
    
    if currentHumanoid.Health <= 0 then
        if currentTarget or isNearTarget then
            resetTarget()
        end
        return
    end
    
    if not scanDone then
        scanTarget()
        return
    end
    
    if currentTarget and currentTarget.Parent and currentTarget:IsA("BasePart") then
        local distanceToTarget = (currentRootPart.Position - currentTarget.Position).Magnitude
        
        if distanceToTarget < 5 then
            if not isNearTarget then
                isNearTarget = true
                statusText.Text = "🔘 Auto click aktif"
                statusText.TextColor3 = Color3.fromRGB(255, 100, 0)
                startAutoClick()
            end
            stopWalking()
        elseif distanceToTarget > searchRadius then
            statusText.Text = "📡 Target keluar radius, mencari ulang"
            statusText.TextColor3 = Color3.fromRGB(255, 150, 0)
            resetTarget()
            scanTarget()
        else
            if isNearTarget then
                isNearTarget = false
                stopAutoClick()
                statusText.Text = "🚶 Menuju target"
                statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
            walkToPart(currentTarget)
        end
    else
        statusText.Text = "💀 Target hilang, mencari ulang"
        statusText.TextColor3 = Color3.fromRGB(255, 150, 0)
        resetTarget()
        scanTarget()
    end
end)

