local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInput = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- TOGGLE STATE
local enabled = true
local TOGGLE_KEY = Enum.KeyCode.KeypadSix

-- INTERNAL STATE
local lastGuiVisible = false
local clickScheduled = false
local lastWhiteBarSize = nil  -- Cache untuk ukuran

-- === TOGGLE HANDLER ===
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        print("[Reeling Script]", enabled and "ON" or "OFF")

        if not enabled then
            lastGuiVisible = false
            clickScheduled = false
            lastWhiteBarSize = nil
        end
    end
end)

-- === CACHE REFERENCES ===
local guiCache = nil
local whiteBarCache = nil
local redBarCache = nil
local parentCache = nil
local frameCache = nil
local cacheTimer = 0

-- === FIND UI dengan caching ===
local function findBars()
    -- Cek cache dulu (refresh tiap 30 frame atau jika nil)
    cacheTimer = cacheTimer + 1
    if cacheTimer < 30 and guiCache and whiteBarCache and redBarCache and whiteBarCache.Parent then
        return whiteBarCache, redBarCache, guiCache, frameCache
    end
    
    cacheTimer = 0
    local gui = player.PlayerGui:FindFirstChild("Reeling")
    if not gui then 
        guiCache = nil
        whiteBarCache = nil
        redBarCache = nil
        parentCache = nil
        frameCache = nil
        return 
    end

    -- Cari frame utama
    local frame = gui:FindFirstChild("Frame", true)
    if not frame then return end

    -- Cari WhiteBar dan RedBar (tanpa recursive kalo bisa)
    local white = frame:FindFirstChild("WhiteBar")
    local red = frame:FindFirstChild("RedBar")

    if white and red then
        -- Update cache
        guiCache = gui
        whiteBarCache = white
        redBarCache = red
        parentCache = white.Parent
        frameCache = frame
        return white, red, gui, frame
    end
    
    guiCache = nil
    whiteBarCache = nil
    redBarCache = nil
    parentCache = nil
    frameCache = nil
end

-- === LEFT CLICK ===
local function leftClick()
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- === MAIN LOOP dengan WhiteBar Full Width ===
RunService.RenderStepped:Connect(function()
    if not enabled then return end

    local WhiteBar, RedBar, gui, frame = findBars()

    -- GUI muncul
    if WhiteBar and RedBar and gui and frame then
        lastGuiVisible = true
        clickScheduled = false

        -- === MODIFIKASI: BUAT WHITEBAR FULL WIDTH ===
        
        -- Opsi A: WhiteBar selebar frame
        local frameWidth = frame.AbsoluteSize.X
        local currentSize = WhiteBar.Size
        
        -- Update ukuran WhiteBar jadi full width (pertahankan tinggi asli)
        if lastWhiteBarSize == nil or lastWhiteBarSize.X.Offset ~= frameWidth then
            WhiteBar.Size = UDim2.new(
                0, frameWidth,           -- Lebar = full width frame
                currentSize.Y.Scale,     -- Tinggi tetap (scale)
                currentSize.Y.Offset     -- Tinggi tetap (offset)
            )
            lastWhiteBarSize = {
                X = {Offset = frameWidth},
                Y = {Scale = currentSize.Y.Scale, Offset = currentSize.Y.Offset}
            }
        end
        
        -- Posisikan WhiteBar di atas RedBar
        local parent = WhiteBar.Parent
        local relativeX = RedBar.AbsolutePosition.X - parent.AbsolutePosition.X
        
        -- Atur posisi WhiteBar (bisa digeser atau di tengah)
        WhiteBar.Position = UDim2.fromOffset(
            relativeX - (frameWidth / 2) + (RedBar.AbsoluteSize.X / 2),  -- Center ke RedBar
            WhiteBar.Position.Y.Offset
        )

        return
    end

    -- GUI baru saja hilang
    if lastGuiVisible and not clickScheduled then
        clickScheduled = true
        lastGuiVisible = false
        lastWhiteBarSize = nil  -- Reset cache

        task.delay(math.random(3, 4), function()
            if enabled then
                leftClick()
            end
        end)
    end
end)
