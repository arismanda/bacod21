local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInput = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- TOGGLE STATE
local enabled = true
local TOGGLE_KEY = Enum.KeyCode.KeypadSix

-- INTERNAL STATE
local lastGuiVisible = false
local clickScheduled = false

-- === TOGGLE HANDLER ===
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        print("[Reeling Script]", enabled and "ON" or "OFF")

        -- reset state saat OFF
        if not enabled then
            lastGuiVisible = false
            clickScheduled = false
        end
    end
end)

-- === FIND UI ===
local function findBars()
    local gui = player.PlayerGui:FindFirstChild("Reeling")
    if not gui then return end

    local frame = gui:FindFirstChild("Frame", true)
    if not frame then return end

    local white = frame:FindFirstChild("WhiteBar", true)
    local red = frame:FindFirstChild("RedBar", true)
    local progressBg = frame:FindFirstChild("ProgressBg", true) -- Cari ProgressBg

    if white and red then
        return white, red, gui, progressBg
    end
end

-- === LEFT CLICK 1x ===
local function leftClick()
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- === MAIN LOOP ===
RunService.RenderStepped:Connect(function()
    if not enabled then return end

    local WhiteBar, RedBar, gui, ProgressBg = findBars()

    -- GUI muncul
    if WhiteBar and RedBar and gui then
        lastGuiVisible = true
        clickScheduled = false

        -- SNAP whitebar ke redbar
        local parent = WhiteBar.Parent
        local relativeX =
            RedBar.AbsolutePosition.X - parent.AbsolutePosition.X

        WhiteBar.Position = UDim2.fromOffset(
            relativeX,
            WhiteBar.Position.Y.Offset
        )
        
        -- SET PROGRESSBG KE UKURAN FULL (1.0 scale X)
        if ProgressBg then
            ProgressBg.Size = UDim2.new(1, 0, ProgressBg.Size.Y.Scale, ProgressBg.Size.Y.Offset)
        end

        return
    end

    -- GUI baru saja hilang
    if lastGuiVisible and not clickScheduled then
        clickScheduled = true
        lastGuiVisible = false

        task.delay(math.random(3, 4), function()
            if enabled then
                leftClick()
            end
        end)
    end
end)
