local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInput = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local enabled = true
local TOGGLE_KEY = Enum.KeyCode.KeypadSix

local lastGuiVisible = false
local clickScheduled = false
local whiteBarLocked = false

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        if not enabled then
            lastGuiVisible = false
            clickScheduled = false
            whiteBarLocked = false
        end
    end
end)

local function getUIElements()
    local reelingGui = player.PlayerGui:FindFirstChild("Reeling")
    if not reelingGui then return end
    
    local outerFrame = reelingGui:FindFirstChild("Frame")
    if not outerFrame then return end
    
    local innerFrame = outerFrame:FindFirstChild("Frame")
    if not innerFrame then return end
    
    local whiteBar = innerFrame:FindFirstChild("WhiteBar")
    
    if whiteBar then
        return whiteBar, innerFrame
    end
end

local function lockWhiteBar()
    local WhiteBar, parentFrame = getUIElements()
    if WhiteBar then
        WhiteBar.Size = UDim2.new(
            1, 0,
            WhiteBar.Size.Y.Scale, WhiteBar.Size.Y.Offset
        )
        
        WhiteBar.Position = UDim2.new(
            0.5, 0,
            WhiteBar.Position.Y.Scale, WhiteBar.Position.Y.Offset
        )
        
        whiteBarLocked = true
    end
end

local function leftClick()
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

RunService.RenderStepped:Connect(function()
    if not enabled then 
        if lastGuiVisible or clickScheduled then
            lastGuiVisible = false
            clickScheduled = false
        end
        return 
    end

    local WhiteBar, parentFrame = getUIElements()

    if WhiteBar and parentFrame then
        if not whiteBarLocked then
            lockWhiteBar()
        else
            WhiteBar.Size = UDim2.new(
                1, 0,
                WhiteBar.Size.Y.Scale, WhiteBar.Size.Y.Offset
            )
            WhiteBar.Position = UDim2.new(
                0.5, 0,
                WhiteBar.Position.Y.Scale, WhiteBar.Position.Y.Offset
            )
        end
        
        lastGuiVisible = true
        clickScheduled = false
        
    elseif lastGuiVisible and not clickScheduled then
        clickScheduled = true
        lastGuiVisible = false
        whiteBarLocked = false
        
        task.delay(2, function()
            if enabled then
                leftClick()
                clickScheduled = false
            end
        end)
    end
end)
