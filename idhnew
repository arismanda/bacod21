local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInput = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- TOGGLE STATE
local enabled = true
local TOGGLE_KEY = Enum.KeyCode.KeypadSix

-- INTERNAL STATE
local lastGuiVisible = false
local clickScheduled = false

-- === TOGGLE HANDLER ===
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        print("[Reeling Script]", enabled and "ON" or "OFF")

        if not enabled then
            lastGuiVisible = false
            clickScheduled = false
        end
    end
end)

-- === DIRECT ACCESS KE UI ===
local function getUIElements()
    -- Path: PlayerGui.Reeling.Frame.ProgressBg.ProgressBar
    local reelingGui = player.PlayerGui:FindFirstChild("Reeling")
    if not reelingGui then return end
    
    local frame = reelingGui:FindFirstChild("Frame")
    if not frame then return end
    
    local progressBg = frame:FindFirstChild("ProgressBg")
    if not progressBg then return end
    
    local progressBar = progressBg:FindFirstChild("ProgressBar")
    local whiteBar = frame:FindFirstChild("WhiteBar")  -- Cari WhiteBar di Frame
    
    if progressBar and whiteBar then
        return progressBar, whiteBar, progressBg, frame
    end
end

-- === LEFT CLICK ===
local function leftClick()
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- === MAIN LOOP ===
RunService.RenderStepped:Connect(function()
    if not enabled then return end

    local ProgressBar, WhiteBar, progressBg, mainFrame = getUIElements()

    -- GUI muncul
    if ProgressBar and WhiteBar and progressBg and mainFrame then
        lastGuiVisible = true
        clickScheduled = false

        -- === SET PROGRESSBAR SIZE KE SCALE 0.9 ===
        -- Scale X = 0.9 (90% lebar ProgressBg)
        -- Pertahankan ukuran Y asli
        local originalSize = ProgressBar.Size
        ProgressBar.Size = UDim2.new(
            0.9, 0,                          -- Scale X = 0.9 (90%), Offset X = 0
            originalSize.Y.Scale,             -- Tinggi scale (asli)
            originalSize.Y.Offset              -- Tinggi offset (asli)
        )
        
        -- === OPSI POSISI PROGRESSBAR ===
        
        -- OPSI 1: Posisi default (kiri)
        -- ProgressBar.Position = UDim2.new(0, 0, 0, 0)  -- Biarkan default
        
        -- OPSI 2: Center di ProgressBg
        local bgWidth = progressBg.AbsoluteSize.X
        local barWidth = ProgressBar.AbsoluteSize.X
        local centerOffset = (bgWidth - barWidth) / 2
        
        ProgressBar.Position = UDim2.fromOffset(
            centerOffset,
            ProgressBar.Position.Y.Offset
        )
        
        -- === WHITEBAR MENGIKUTI POSISI PROGRESSBAR ===
        -- Hitung posisi WhiteBar berdasarkan ProgressBar
        local barCenter = ProgressBar.AbsolutePosition.X + (ProgressBar.AbsoluteSize.X / 2)
        local frameLeft = mainFrame.AbsolutePosition.X
        local whiteBarWidth = WhiteBar.AbsoluteSize.X
        
        -- Posisikan WhiteBar center ke ProgressBar
        WhiteBar.Position = UDim2.fromOffset(
            barCenter - frameLeft - (whiteBarWidth / 2),
            WhiteBar.Position.Y.Offset
        )

        return
    end

    -- GUI baru saja hilang
    if lastGuiVisible and not clickScheduled then
        clickScheduled = true
        lastGuiVisible = false

        task.delay(math.random(3, 4), function()
            if enabled then
                leftClick()
            end
        end)
    end
end)
