local player = game.Players.LocalPlayer
local replicatedStorage = game:GetService("ReplicatedStorage")
local remoteFunction = replicatedStorage:WaitForChild("RemoteFunction")

-- Variabel kontrol
local isRunning = false
local currentCoroutine = nil
local isMinimized = false

-- Function untuk mendapatkan semua vigilante
local function getAllVigilantes()
    local towersFolder = workspace:WaitForChild("Towers")
    local vigilantes = {}
    
    for _, tower in pairs(towersFolder:GetChildren()) do
        if tower.Name == "Fallen" then
            table.insert(vigilantes, tower)
        end
    end
    
    return vigilantes
end

-- Function untuk mengaktifkan ability
local function activateVigilanteAbility(vigilante)
    local args = {
        "Troops",
        "Abilities",
        "Activate",
        {
            Troop = vigilante,
            Name = "Call Of Arms",
            Data = {}
        }
    }
    
    local success = pcall(function()
        return remoteFunction:InvokeServer(unpack(args))
    end)
    
    return success
end

-- Function utama untuk loop ability
local function vigilanteAbilityLoop()
    local lastActivatedIndex = 0
    
    while isRunning do
        local vigilantes = getAllVigilantes()
        
        if #vigilantes > 0 then            
            local startIndex = (lastActivatedIndex % #vigilantes) + 1
            
            for i = 1, #vigilantes do
                if not isRunning then break end
                
                local currentIndex = ((startIndex + i - 2) % #vigilantes) + 1
                local vigilante = vigilantes[currentIndex]
                
                activateVigilanteAbility(vigilante)
                lastActivatedIndex = currentIndex
                
                task.wait(0.5) -- delay 0.5 detik antar ability
            end
        else
            task.wait(1)
        end
        
        task.wait(5) -- delay 5 detik sebelum loop lagi
    end
end

-- Function untuk start script
local function startScript()
    if isRunning then return end
    isRunning = true
    currentCoroutine = coroutine.wrap(vigilanteAbilityLoop)
    currentCoroutine()
end

-- Function untuk stop script
local function stopScript()
    isRunning = false
    currentCoroutine = nil
end

