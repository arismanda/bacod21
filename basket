-- Variables
local isLooping = false
local currentThread = nil
local actionEvent = game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("RequestServerAction")

-- Function to fire the action
local function fireAction()
	local val1 = tonumber(value1Box.Text)
	local val2 = tonumber(value2Box.Text)
	
	if val1 and val2 then
		local args = {
			"Gameplay",
			"Train",
			{
				val1,
				val2
			}
		}
		
		actionEvent:FireServer(unpack(args))
		statusLabel.Text = "Action fired! (Value1: " .. val1 .. ", Value2: " .. val2 .. ")"
		task.wait(0.5)
		statusLabel.Text = "Ready"
	else
		statusLabel.Text = "Error: Invalid values!"
		task.wait(1)
		statusLabel.Text = "Ready"
	end
end

-- Function to start/stop loop
local function toggleLoop()
	isLooping = not isLooping
	
	if isLooping then
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
		toggleBtn.Text = "ON"
		toggleLabel.Text = "Loop: ON"
		statusLabel.Text = "Loop started"
		
		-- Start the loop in a separate thread
		coroutine.wrap(function()
			local delay = tonumber(speedBox.Text) or 1
			local multiplier = tonumber(multiplierBox.Text) or 1
			
			while isLooping do
				for i = 1, multiplier do
					if not isLooping then break end
					fireAction()
					if i < multiplier then
						task.wait(delay)
					end
				end
				if isLooping then
					task.wait(delay)
				end
			end
		end)()
	else
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		toggleBtn.Text = "OFF"
		toggleLabel.Text = "Loop: OFF"
		statusLabel.Text = "Loop stopped"
		task.wait(0.5)
		statusLabel.Text = "Ready"
	end
end

-- Toggle button click
toggleBtn.MouseButton1Click:Connect(toggleLoop)

-- Apply button click
applyBtn.MouseButton1Click:Connect(function()
	local val1 = tonumber(value1Box.Text)
	local val2 = tonumber(value2Box.Text)
	local delay = tonumber(speedBox.Text)
	local multiplier = tonumber(multiplierBox.Text)
	
	-- Validate inputs
	local errors = {}
	if not val1 then table.insert(errors, "Value 1") end
	if not val2 then table.insert(errors, "Value 2") end
	if not delay or delay <= 0 then table.insert(errors, "Delay") end
	if not multiplier or multiplier <= 0 then table.insert(errors, "Multiplier") end
	
	if #errors > 0 then
		statusLabel.Text = "Invalid: " .. table.concat(errors, ", ")
		task.wait(1.5)
		statusLabel.Text = "Ready"
		return
	end
	
	-- Clamp values
	delay = math.max(0.1, delay)
	multiplier = math.max(1, math.floor(multiplier))
	
	speedBox.Text = delay
	multiplierBox.Text = multiplier
	
	statusLabel.Text = "Settings applied!"
	task.wait(0.5)
	statusLabel.Text = "Ready"
	
	-- If not looping, fire once
	if not isLooping then
		fireAction()
	end
end)

-- Input validation for number boxes
local function validateNumberBox(box, defaultValue)
	box.FocusLost:Connect(function(enterPressed)
		local num = tonumber(box.Text)
		if not num then
			box.Text = defaultValue
		else
			if box == speedBox and num < 0.1 then
				box.Text = "0.1"
			elseif box == multiplierBox and num < 1 then
				box.Text = "1"
			else
				box.Text = num
			end
		end
	end)
end

validateNumberBox(value1Box, "2")
validateNumberBox(value2Box, "1")
validateNumberBox(speedBox, "1")
validateNumberBox(multiplierBox, "1")
