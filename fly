-- Variabel yang diperlukan
FLYING = false
QEfly = true  -- Aktifkan tombol Q dan E untuk naik/turun (keyboard only)
iyflyspeed = 1  -- Kecepatan terbang default

-- Variabel untuk touch joystick di mobile
local touchJoystickActive = false
local joystickCenter = nil
local joystickHandle = nil
local joystickRadius = 80

-- Variabel untuk kontrol toggle
local isFlyingActive = false
local currentFlyThread = nil

