-- Fungsi untuk memulai terbang
local function startFly()
    if bodyVel then bodyVel:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    
    bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVel.Parent = rootPart
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bodyGyro.Parent = rootPart
    
    humanoid.PlatformStand = true
    flying = true
    
    -- Loop gerakan
    game:GetService("RunService").RenderStepped:Connect(function()
        if not flying then return end
        if not rootPart or not bodyVel or not bodyGyro then return end
        
        local moveDirection = Vector3.new()
        local camera = workspace.CurrentCamera
        local cameraCFrame = camera.CFrame
        
        -- Mendapatkan input dari keyboard (WASD)
        if userInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + cameraCFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - cameraCFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - cameraCFrame.RightVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + cameraCFrame.RightVector
        end
        
        -- Mendapatkan input dari touch (joystick) untuk mobile
        -- (Contoh sederhana: gunakan tombol Up/Down untuk vertikal)
        -- Catatan: Untuk kontrol thumbstick penuh, Anda perlu menggunakan modul MoveVector yang lebih kompleks
        
        -- Atur kecepatan dan arah terbang
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * speed
        else
            moveDirection = Vector3.new(0, 0, 0)
        end
        
        -- Tambahkan komponen vertikal dari tombol Up/Down
        -- (Pada script penuh, Anda bisa menggabungkan dengan input dari thumbstick)
        
        bodyVel.Velocity = moveDirection
        bodyGyro.CFrame = cameraCFrame
    end)
end

-- Fungsi untuk berhenti terbang
local function stopFly()
    if bodyVel then bodyVel:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    humanoid.PlatformStand = false
    flying = false
end

-- Event untuk tombol Fly
flyButton.MouseButton1Click:Connect(function()
    if flying then
        stopFly()
        flyButton.Text = "Fly (OFF)"
        flyButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    else
        startFly()
        flyButton.Text = "Fly (ON)"
        flyButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

-- Event untuk tombol Speed
speedUp.MouseButton1Click:Connect(function()
    speed = math.min(speed + 10, 500)
    speedLabel.Text = "Speed: " .. speed
end)

speedDown.MouseButton1Click:Connect(function()
    speed = math.max(speed - 10, 10)
    speedLabel.Text = "Speed: " .. speed
end)

-- Event untuk tombol vertikal (Up/Down)
upButton.MouseButton1Click:Connect(function()
    if flying and rootPart then
        rootPart.Velocity = rootPart.Velocity + Vector3.new(0, 20, 0)
    end
end)

downButton.MouseButton1Click:Connect(function()
    if flying and rootPart then
        rootPart.Velocity = rootPart.Velocity - Vector3.new(0, 20, 0)
    end
end)

-- Perbarui karakter jika respawn
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    rootPart = character:WaitForChild("HumanoidRootPart")
    if flying then
        stopFly()
        flyButton.Text = "Fly (OFF)"
        flyButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    end
end)

