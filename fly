-- SIMPLE FLY SCRIPT FOR MOBILE (No GUI Conflicts)
-- Tap 3 fingers to toggle fly

local Player = game.Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- Variables
local flying = false
local speed = 50
local bodyVelocity = nil
local bodyGyro = nil
local moveDirection = Vector3.new(0, 0, 0)

-- Joystick variables
local joystickActive = false
local joystickStartPos = nil
local joystickCurrentPos = nil
local joystickUI = nil

local function getCharacter()
    local char = Player.Character
    if not char or not char.Parent then return nil end
    return char
end

local function getRootPart()
    local char = getCharacter()
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function getHumanoid()
    local char = getCharacter()
    if char then
        return char:FindFirstChild("Humanoid")
    end
    return nil
end

local function stopFly()
    if bodyVelocity then
        pcall(function() bodyVelocity:Destroy() end)
        bodyVelocity = nil
    end
    if bodyGyro then
        pcall(function() bodyGyro:Destroy() end)
        bodyGyro = nil
    end
    flying = false
    
    -- Hide joystick
    if joystickUI and joystickUI.Parent then
        joystickUI.Visible = false
    end
    
    -- Reset platform stand
    local hum = getHumanoid()
    if hum then
        hum.PlatformStand = false
    end
end

local function startFly()
    if flying then stopFly() end
    
    local rootPart = getRootPart()
    local hum = getHumanoid()
    
    if not rootPart or not hum then
        warn("Cannot fly: Character not ready")
        return false
    end
    
    -- Setup BodyVelocity
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    -- Setup BodyGyro
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bodyGyro.Parent = rootPart
    bodyGyro.CFrame = rootPart.CFrame
    
    -- Enable platform stand
    hum.PlatformStand = true
    
    flying = true
    moveDirection = Vector3.new(0, 0, 0)
    
    -- Show joystick
    createJoystick()
    
    -- Notify
    notify("✈️ Fly Mode: ON", Color3.fromRGB(100, 255, 100))
    
    return true
end

local function toggleFly()
    if flying then
        stopFly()
        notify("🛑 Fly Mode: OFF", Color3.fromRGB(255, 100, 100))
    else
        startFly()
    end
end

local function updateFlyDirection()
    if not flying or not bodyVelocity then return end
    
    local rootPart = getRootPart()
    if not rootPart then return end
    
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local moveVec = moveDirection
    
    if moveVec.Magnitude > 0.1 then
        local camCF = cam.CFrame
        local forward = camCF.LookVector
        local right = camCF.RightVector
        local up = camCF.UpVector
        
        -- Calculate movement
        local direction = (right * moveVec.X + up * moveVec.Y + forward * -moveVec.Z)
        direction = direction.Unit
        
        bodyVelocity.Velocity = direction * speed
        
        -- Update rotation
        if bodyGyro then
            bodyGyro.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + direction)
        end
    else
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    end
end

-- Simple notification
local function notify(text, color)
    local screenGui = Player.PlayerGui:FindFirstChild("FlyNotification")
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "FlyNotification"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = Player.PlayerGui
    end
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 250, 0, 40)
    frame.Position = UDim2.new(0.5, -125, 0.8, 0)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    label.TextSize = 16
    label.Font = Enum.Font.Gothom
    label.TextScaled = true
    label.Parent = frame
    
    game:GetService("TweenService"):Create(frame, 
        TweenInfo.new(2, Enum.EasingStyle.Linear), 
        {BackgroundTransparency = 1}
    ):Play()
    
    task.wait(2)
    pcall(function() frame:Destroy() end)
end

-- Create joystick UI
local function createJoystick()
    -- Remove existing
    if joystickUI and joystickUI.Parent then
        joystickUI:Destroy()
    end
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "FlyJoystick"
    gui.ResetOnSpawn = false
    gui.Parent = Player.PlayerGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 120, 0, 120)
    frame.Position = UDim2.new(0, 10, 1, -140)
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    frame.BackgroundTransparency = 0.6
    frame.BorderSizePixel = 0
    frame.Parent = gui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = frame
    
    local border = Instance.new("UIStroke")
    border.Color = Color3.fromRGB(100, 100, 150)
    border.Thickness = 2
    border.Transparency = 0.5
    border.Parent = frame
    
    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 50, 0, 50)
    thumb.Position = UDim2.new(0.5, -25, 0.5, -25)
    thumb.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
    thumb.BackgroundTransparency = 0.4
    thumb.BorderSizePixel = 0
    thumb.Parent = frame
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = thumb
    
    local speedFrame = Instance.new("Frame")
    speedFrame.Size = UDim2.new(0, 80, 0, 30)
    speedFrame.Position = UDim2.new(0, 20, 0, 125)
    speedFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    speedFrame.BackgroundTransparency = 0.3
    speedFrame.BorderSizePixel = 0
    speedFrame.Parent = gui
    
    local speedCorner = Instance.new("UICorner")
    speedCorner.CornerRadius = UDim.new(0, 6)
    speedCorner.Parent = speedFrame
    
    local speedText = Instance.new("TextLabel")
    speedText.Size = UDim2.new(1, 0, 1, 0)
    speedText.BackgroundTransparency = 1
    speedText.Text = tostring(speed)
    speedText.TextColor3 = Color3.fromRGB(255, 255, 255)
    speedText.TextSize = 14
    speedText.Font = Enum.Font.GothomBold
    speedText.Parent = speedFrame
    
    -- Buttons
    local upBtn = Instance.new("TextButton")
    upBtn.Size = UDim2.new(0, 40, 0, 30)
    upBtn.Position = UDim2.new(0, 105, 0, 125)
    upBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    upBtn.Text = "▲"
    upBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    upBtn.TextSize = 16
    upBtn.Font = Enum.Font.GothomBold
    upBtn.Parent = gui
    
    local downBtn = Instance.new("TextButton")
    downBtn.Size = UDim2.new(0, 40, 0, 30)
    downBtn.Position = UDim2.new(0, 150, 0, 125)
    downBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    downBtn.Text = "▼"
    downBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    downBtn.TextSize = 16
    downBtn.Font = Enum.Font.GothomBold
    downBtn.Parent = gui
    
    -- Store references
    joystickUI = gui
    local joystickFrame = frame
    local joystickThumb = thumb
    
    -- Touch handling
    local center = Vector2.new(0, 0)
    local maxRadius = 50
    local active = false
    
    local function updateThumb(pos)
        local delta = pos - center
        local distance = math.min(delta.Magnitude, maxRadius)
        local direction = distance > 0 and delta.Unit or Vector2.new(0, 0)
        
        local offset = direction * distance
        joystickThumb.Position = UDim2.new(0.5, offset.X - 25, 0.5, offset.Y - 25)
        
        -- Update move direction
        local normX = direction.X * (distance / maxRadius)
        local normY = direction.Y * (distance / maxRadius)
        moveDirection = Vector3.new(normX, normY, 0)
        
        updateFlyDirection()
    end
    
    joystickFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            active = true
            center = joystickFrame.AbsolutePosition + Vector2.new(60, 60)
            updateThumb(input.Position)
        end
    end)
    
    UserInputService.TouchMoved:Connect(function(input, processed)
        if not processed and active then
            updateThumb(input.Position)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch and active then
            active = false
            moveDirection = Vector3.new(0, 0, 0)
            joystickThumb.Position = UDim2.new(0.5, -25, 0.5, -25)
            updateFlyDirection()
        end
    end)
    
    -- Speed buttons
    upBtn.MouseButton1Click:Connect(function()
        speed = math.min(200, speed + 10)
        speedText.Text = tostring(speed)
        notify("Speed: " .. tostring(speed), Color3.fromRGB(255, 200, 100))
    end)
    
    downBtn.MouseButton1Click:Connect(function()
        speed = math.max(10, speed - 10)
        speedText.Text = tostring(speed)
        notify("Speed: " .. tostring(speed), Color3.fromRGB(255, 200, 100))
    end)
end

-- Character respawn handling
Player.CharacterAdded:Connect(function()
    task.wait(0.5)
    if flying then
        -- Recreate fly after respawn
        local success = startFly()
        if not success then
            flying = false
        end
    end
end)

-- 3-finger tap to toggle
local tapCount = 0
local tapTimer = nil

UserInputService.TouchTap:Connect(function(touchPos, tapCount_, isFinal)
    if isFinal then
        if tapTimer then
            tapTimer:Disconnect()
            tapTimer = nil
        end
        
        tapCount = tapCount + 1
        
        tapTimer = game:GetService("RunService").Stepped:Connect(function()
            tapTimer:Disconnect()
            tapTimer = nil
            
            if tapCount >= 3 then
                toggleFly()
            end
            tapCount = 0
        end)
        
        task.wait(0.3)
        if tapTimer then
            tapTimer:Disconnect()
            tapTimer = nil
            if tapCount < 3 then
                tapCount = 0
            end
        end
    end
end)

-- Chat command
local function setupChatCommand()
    local onChat = function(msg)
        if msg:lower() == ";fly" then
            toggleFly()
        elseif msg:lower() == ";flyspeed" then
            notify("Current speed: " .. tostring(speed), Color3.fromRGB(200, 200, 255))
        end
    end
    
    -- Legacy chat
    game:GetService("Players").Chatted:Connect(onChat)
end

setupChatCommand()

-- Main update loop
RunService.RenderStepped:Connect(function()
    if flying then
        updateFlyDirection()
    end
end)

-- Initial notification
notify("✨ Fly Script Loaded!\nTap 3 fingers to toggle fly", Color3.fromRGB(100, 200, 255))

print("Fly Script for Mobile Loaded! Use 3-finger tap or type ;fly to toggle")
