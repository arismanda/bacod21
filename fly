-- Command for console (type ';fly' in chat)
local function onChatMessage(message)
    if message:lower() == ";fly" then
        if flying then
            stopFly()
        else
            startFly()
        end
    elseif message:lower() == ";flygui" then
        mainFrame.Visible = not mainFrame.Visible
    end
end

-- For chat detection (works with both legacy and new chat)
local function setupChatHook()
    local TextChatService = game:GetService("TextChatService")
    
    if TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService then
        -- Legacy chat
        Players.Chatted:Connect(onChatMessage)
    else
        -- New chat system
        local textChannels = TextChatService:FindFirstChild("TextChannels")
        if textChannels then
            local rbGeneral = textChannels:FindFirstChild("RBGeneral")
            if rbGeneral then
                rbGeneral.MessageReceived:Connect(function(message)
                    if message.TextSource then
                        local speaker = message.TextSource.Name
                        if speaker == Player.Name then
                            onChatMessage(message.Text)
                        end
                    end
                end)
            end
        end
    end
end

