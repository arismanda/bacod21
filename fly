-- FIXED FLY SCRIPT FOR MOBILE (No comparison errors)
-- Tap 3 fingers to toggle fly

local Player = game.Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- Variables
local flying = false
local speed = 50
local bodyVelocity = nil
local bodyGyro = nil
local moveDirection = Vector3.new(0, 0, 0)

-- Joystick variables
local joystickActive = false
local joystickUI = nil

local function getCharacter()
    local char = Player.Character
    if char and char.Parent then
        return char
    end
    return nil
end

local function getRootPart()
    local char = getCharacter()
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function getHumanoid()
    local char = getCharacter()
    if char then
        return char:FindFirstChild("Humanoid")
    end
    return nil
end

local function stopFly()
    if bodyVelocity then
        pcall(function() bodyVelocity:Destroy() end)
        bodyVelocity = nil
    end
    if bodyGyro then
        pcall(function() bodyGyro:Destroy() end)
        bodyGyro = nil
    end
    flying = false
    moveDirection = Vector3.new(0, 0, 0)
    
    if joystickUI and joystickUI.Parent then
        joystickUI.Visible = false
    end
    
    local hum = getHumanoid()
    if hum then
        pcall(function() hum.PlatformStand = false end)
    end
end

local function startFly()
    if flying then 
        stopFly()
        return false
    end
    
    local rootPart = getRootPart()
    local hum = getHumanoid()
    
    if not rootPart or not hum then
        return false
    end
    
    -- Setup BodyVelocity
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    -- Setup BodyGyro
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bodyGyro.Parent = rootPart
    bodyGyro.CFrame = rootPart.CFrame
    
    hum.PlatformStand = true
    
    flying = true
    moveDirection = Vector3.new(0, 0, 0)
    
    createJoystick()
    
    return true
end

local function toggleFly()
    if flying then
        stopFly()
        notify("Fly Mode: OFF")
    else
        local success = startFly()
        if success then
            notify("Fly Mode: ON")
        else
            notify("Failed to start fly mode")
        end
    end
end

local function updateFlyDirection()
    if not flying or not bodyVelocity then 
        return 
    end
    
    local rootPart = getRootPart()
    if not rootPart then 
        return 
    end
    
    local cam = workspace.CurrentCamera
    if not cam then 
        return 
    end
    
    local moveVec = moveDirection
    
    if moveVec.Magnitude > 0.1 then
        local camCF = cam.CFrame
        local forward = camCF.LookVector
        local right = camCF.RightVector
        local up = camCF.UpVector
        
        local direction = (right * moveVec.X + up * moveVec.Y + forward * -moveVec.Z)
        direction = direction.Unit
        
        bodyVelocity.Velocity = direction * speed
        
        if bodyGyro then
            bodyGyro.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + direction)
        end
    else
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    end
end

-- Simple notification
local function notify(text)
    local screenGui = Player:FindFirstChild("PlayerGui")
    if not screenGui then return end
    
    local notifGui = screenGui:FindFirstChild("FlyNotification")
    if not notifGui then
        notifGui = Instance.new("ScreenGui")
        notifGui.Name = "FlyNotification"
        notifGui.ResetOnSpawn = false
        notifGui.Parent = screenGui
    end
    
    -- Clean up old notifications
    for _, child in pairs(notifGui:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 36)
    frame.Position = UDim2.new(0.5, -100, 0.85, 0)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.Parent = notifGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.Parent = frame
    
    task.wait(1.5)
    pcall(function() frame:Destroy() end)
end

-- Create joystick UI
local function createJoystick()
    if joystickUI then
        pcall(function() joystickUI:Destroy() end)
        joystickUI = nil
    end
    
    local playerGui = Player:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "FlyJoystick"
    gui.ResetOnSpawn = false
    gui.Parent = playerGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 100, 0, 100)
    frame.Position = UDim2.new(0, 10, 1, -120)
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 0
    frame.Parent = gui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = frame
    
    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 40, 0, 40)
    thumb.Position = UDim2.new(0.5, -20, 0.5, -20)
    thumb.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    thumb.BackgroundTransparency = 0.3
    thumb.BorderSizePixel = 0
    thumb.Parent = frame
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = thumb
    
    local speedFrame = Instance.new("Frame")
    speedFrame.Size = UDim2.new(0, 70, 0, 28)
    speedFrame.Position = UDim2.new(0, 15, 0, 105)
    speedFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    speedFrame.BackgroundTransparency = 0.3
    speedFrame.BorderSizePixel = 0
    speedFrame.Parent = gui
    
    local speedCorner = Instance.new("UICorner")
    speedCorner.CornerRadius = UDim.new(0, 6)
    speedCorner.Parent = speedFrame
    
    local speedText = Instance.new("TextLabel")
    speedText.Size = UDim2.new(1, 0, 1, 0)
    speedText.BackgroundTransparency = 1
    speedText.Text = tostring(speed)
    speedText.TextColor3 = Color3.fromRGB(255, 255, 255)
    speedText.TextSize = 14
    speedText.Font = Enum.Font.GothamBold
    speedText.Parent = speedFrame
    
    -- Speed buttons
    local upBtn = Instance.new("TextButton")
    upBtn.Size = UDim2.new(0, 35, 0, 28)
    upBtn.Position = UDim2.new(0, 90, 0, 105)
    upBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    upBtn.Text = "+"
    upBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    upBtn.TextSize = 16
    upBtn.Font = Enum.Font.GothamBold
    upBtn.Parent = gui
    
    local downBtn = Instance.new("TextButton")
    downBtn.Size = UDim2.new(0, 35, 0, 28)
    downBtn.Position = UDim2.new(0, 130, 0, 105)
    downBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    downBtn.Text = "-"
    downBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    downBtn.TextSize = 16
    downBtn.Font = Enum.Font.GothamBold
    downBtn.Parent = gui
    
    joystickUI = gui
    
    -- Touch handling
    local center = Vector2.new(0, 0)
    local maxRadius = 40
    local active = false
    
    local function updateThumb(pos)
        if not center then return end
        local delta = pos - center
        local distance = math.min(delta.Magnitude, maxRadius)
        local direction = (distance > 0 and delta.Unit) or Vector2.new(0, 0)
        
        local offset = direction * distance
        local newX = 0.5 + (offset.X / 100)
        local newY = 0.5 + (offset.Y / 100)
        thumb.Position = UDim2.new(newX, -20, newY, -20)
        
        local normX = direction.X * (distance / maxRadius)
        local normY = direction.Y * (distance / maxRadius)
        moveDirection = Vector3.new(normX, normY, 0)
        
        updateFlyDirection()
    end
    
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            active = true
            local absPos = frame.AbsolutePosition
            center = absPos + Vector2.new(50, 50)
            updateThumb(input.Position)
        end
    end)
    
    UserInputService.TouchMoved:Connect(function(input, processed)
        if not processed and active then
            updateThumb(input.Position)
        end
    end)
    
    local function onInputEnded(input)
        if input.UserInputType == Enum.UserInputType.Touch and active then
            active = false
            moveDirection = Vector3.new(0, 0, 0)
            thumb.Position = UDim2.new(0.5, -20, 0.5, -20)
            updateFlyDirection()
        end
    end
    
    UserInputService.InputEnded:Connect(onInputEnded)
    
    -- Speed buttons
    upBtn.MouseButton1Click:Connect(function()
        if speed < 200 then
            speed = speed + 10
            speedText.Text = tostring(speed)
            notify("Speed: " .. tostring(speed))
        end
    end)
    
    downBtn.MouseButton1Click:Connect(function()
        if speed > 10 then
            speed = speed - 10
            speedText.Text = tostring(speed)
            notify("Speed: " .. tostring(speed))
        end
    end)
end

-- Character respawn
Player.CharacterAdded:Connect(function()
    task.wait(0.5)
    if flying then
        -- Restart fly after respawn
        local rootPart = getRootPart()
        local hum = getHumanoid()
        
        if rootPart and hum then
            if bodyVelocity then
                pcall(function() bodyVelocity:Destroy() end)
                bodyVelocity = nil
            end
            if bodyGyro then
                pcall(function() bodyGyro:Destroy() end)
                bodyGyro = nil
            end
            
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = rootPart
            
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            bodyGyro.Parent = rootPart
            bodyGyro.CFrame = rootPart.CFrame
            
            hum.PlatformStand = true
        else
            flying = false
        end
    end
end)

-- 3-finger tap detection
local tapCount = 0
local tapTimer = nil

UserInputService.TouchTap:Connect(function(touchPos, tapCount_, isFinal)
    if isFinal then
        if tapTimer then
            tapTimer:Disconnect()
            tapTimer = nil
        end
        
        tapCount = tapCount + 1
        
        tapTimer = game:GetService("RunService").Stepped:Connect(function()
            tapTimer:Disconnect()
            tapTimer = nil
            
            if tapCount >= 3 then
                toggleFly()
            end
            tapCount = 0
        end)
        
        task.wait(0.3)
        if tapTimer then
            tapTimer:Disconnect()
            tapTimer = nil
            if tapCount < 3 then
                tapCount = 0
            end
        end
    end
end)

-- Chat command
game:GetService("Players").Chatted:Connect(function(msg)
    local lowerMsg = string.lower(msg or "")
    if lowerMsg == ";fly" then
        toggleFly()
    elseif lowerMsg == ";flyspeed" then
        notify("Speed: " .. tostring(speed))
    end
end)

-- Main loop
RunService.RenderStepped:Connect(function()
    if flying then
        updateFlyDirection()
    end
end)

-- Success message
notify("Fly Script Loaded! Tap 3 fingers to fly")
print("Fly Script for Mobile Loaded! Use ;fly or 3-finger tap")
