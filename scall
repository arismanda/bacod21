-- ===== BYPASS LEVEL 3: Hook Metatable =====
local function applyHook()
    if hookApplied then return end
    if not humanoid then return end
    
    local success, mt = pcall(getrawmetatable, humanoid)
    if not success or not mt then return end
    
    local oldNewIndex = mt.__newindex
    local oldIndex = mt.__index
    
    setreadonly(mt, false)
    
    mt.__newindex = function(t, k, v)
        if isEnabled and (k == "WalkSpeed" or k == "JumpPower" or k == "UseJumpPower") then
            if k == "WalkSpeed" and v ~= currentWalkSpeed then
                return -- Block
            end
            if k == "JumpPower" and v ~= currentJumpPower then
                return -- Block
            end
            if k == "UseJumpPower" and v ~= true then
                return -- Block
            end
        end
        return oldNewIndex(t, k, v)
    end
    
    setreadonly(mt, true)
    hookApplied = true
end

-- ===== BYPASS LEVEL 2: Loop Override =====
local function startOverride()
    if overrideConnection then overrideConnection:Disconnect() end
    
    overrideConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not isEnabled then return end
        if not humanoid or not humanoid.Parent then return end
        
        -- Force setiap 0.05 detik (lebih halus dari Stepped)
        if humanoid.WalkSpeed ~= currentWalkSpeed then
            humanoid.WalkSpeed = currentWalkSpeed
        end
        if humanoid.JumpPower ~= currentJumpPower then
            humanoid.JumpPower = currentJumpPower
        end
        if humanoid.UseJumpPower ~= true then
            humanoid.UseJumpPower = true
        end
    end)
end

-- ===== BYPASS LEVEL 1: Event Response =====
local function setupEventResponse()
    -- Respon cepat ke perubahan
    local wsChanged = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if not isEnabled then return end
        if humanoid.WalkSpeed ~= currentWalkSpeed then
            task.spawn(function()
                task.wait(0.01)
                if humanoid and humanoid.Parent then
                    humanoid.WalkSpeed = currentWalkSpeed
                end
            end)
        end
    end)
    
    local jpChanged = humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if not isEnabled then return end
        if humanoid.JumpPower ~= currentJumpPower then
            task.spawn(function()
                task.wait(0.01)
                if humanoid and humanoid.Parent then
                    humanoid.JumpPower = currentJumpPower
                end
            end)
        end
    end)
    
    return wsChanged, jpChanged
end

